    <dcterms:description xml:lang="en">A positional description is a description of location using some system or frame of reference.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000466">
    <dcterms:description xml:lang="en">A global maximum stationary point is a data point that corresponds to a measurement value is larger than that of all other plotted datapoints.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000742"/>
