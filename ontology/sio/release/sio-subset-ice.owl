    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:description xml:lang="en">a notation is a series or system of written symbols used to represent numbers, amounts, or elements.</dc:description>
    <rdfs:label xml:lang="en">notation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000090"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000279">
    <rdfs:label xml:lang="en">mass</rdfs:label>
    <dcterms:description xml:lang="en">mass is the quality of the amount of substance.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000037"/>
