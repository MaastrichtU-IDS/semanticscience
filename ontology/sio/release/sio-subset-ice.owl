    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001447"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sequence assembly</rdfs:label>
    <dcterms:description xml:lang="en">A sequence assembly is a symbolic sequence representing an ordered sequence of biological symbols that is produced by a sequence assembly process through the integration of multiple sequence inputs.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000156">
    <rdfs:label xml:lang="en">book volume</rdfs:label>
    <dcterms:description xml:lang="en">A book volume is a book that is part of a collection.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000106"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
