  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000177">
    <dcterms:description xml:lang="en">A page range denotes the start and end page in some document.</dcterms:description>
    <rdfs:label xml:lang="en">page range</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000944"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
