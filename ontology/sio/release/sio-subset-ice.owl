    <ns1:subset>geometry+</ns1:subset>
    <dcterms:description>A geometric entity is an information content entity that pertains to the structure and topology of a space.</dcterms:description>
    <rdfs:label xml:lang="en">geometric entity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000015"/>
