    <rdfs:label xml:lang="en">biochemical pathway</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000924">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001194"/>
