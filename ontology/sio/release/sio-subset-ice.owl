  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000752">
    <dcterms:description xml:lang="en">A row represents a single, implicitly structured data item in a table. </dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000602"/>
