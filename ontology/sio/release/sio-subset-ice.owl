    <rdfs:label xml:lang="en">namespace</rdfs:label>
    <dcterms:description xml:lang="en">A namespace is an informational entity that defines a logical container for a set of symbols or identifiers.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000602"/>
