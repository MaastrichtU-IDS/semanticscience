    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001196"/>
    <dcterms:description xml:lang="en">evolutionary lineage is a sequence of species, that form a line of descent, each new species the direct result of speciation from an immediate ancestral species.</dcterms:description>
    <rdfs:label xml:lang="en">evolutionary lineage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000318">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">longitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000013"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000319"/>
    <dcterms:description xml:lang="en">Longitude is a geographic position that refers to  the angle east or west of a reference meridian between the two geographical poles to another meridian that passes through an arbitrary point.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
