    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene-disease association linked with chromosomal rearrangement</rdfs:label>
    <dcterms:description xml:lang="en">A gene-disease association in which the gene is included in a chromosomal rearrangement associated with a particular manifestation of the disease.</dcterms:description>
