    <dcterms:description xml:lang="en">a right closed interval is an interval in which there is a real number that is larger than all of its elements.</dcterms:description>
    <rdfs:label xml:lang="en">right closed interval</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001246"/>
