    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000752"/>
    <dcterms:description xml:lang="en">A database row is a row that is part of a database table.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">database row</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
