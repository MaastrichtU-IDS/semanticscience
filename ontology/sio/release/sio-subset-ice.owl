  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000449">
    <skos:example xml:lang="en">The square portion of the chart bounded by lines that overlap with 
the two axes in Graph 1 of http://tinyurl.com/opwnvm</skos:example>
    <rdfs:label xml:lang="en">plot</rdfs:label>
    <dcterms:description xml:lang="en">A plot is a part of a figure that corresponds to the spatial region between the set of axes.</dcterms:description>
