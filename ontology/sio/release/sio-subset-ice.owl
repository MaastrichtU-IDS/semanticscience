    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000602"/>
    <dcterms:description xml:lang="en">A database entry is a single, implicitly structured data item in a table.</dcterms:description>
    <rdfs:label xml:lang="en">database entry</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
