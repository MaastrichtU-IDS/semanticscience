  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001166">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000136"/>
    <dcterms:description xml:lang="en">An annotation is a written explanatory or critical description, or other in-context information (e.g., pattern, motif, link), that has been associated with data or other types of information.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">annotation</rdfs:label>
