    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000289"/>
    <dcterms:description xml:lang="en">A class is a collection of sets which can be unambiguously defined by a property that all its members share.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
  </rdf:Description>
