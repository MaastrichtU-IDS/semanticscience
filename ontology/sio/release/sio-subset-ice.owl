    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A heatmap is a graphical representation of data where the individual values contained in a matrix are represented as colors.</dcterms:description>
    <rdfs:label xml:lang="en">heatmap</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-ice.owl"/>
