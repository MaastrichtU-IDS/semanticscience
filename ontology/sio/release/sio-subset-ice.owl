    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000094"/>
    <dcterms:description xml:lang="en">A workflow is an algorithm that is is a depiction of a sequence of operations to achieve one or more objectives.</dcterms:description>
