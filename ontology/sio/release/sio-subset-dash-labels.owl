  <rdf:Description rdf:about="http://semanticscience.org/resource/covalent-bond">
    <rdfs:subClassOf rdf:nodeID="N1df659d473894700acb97ef506eb1a8e"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/strong-submolecular-component"/>
    <dc:identifier>SIO_011118</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">covalent bond</rdfs:label>
    <skos:exactMatch>CHEMINF:000063</skos:exactMatch>
    <dcterms:description xml:lang="en">A covalent bond is a strong submolecular interaction between atoms.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/ion">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-entity"/>
    <rdfs:label xml:lang="en">ion</rdfs:label>
    <dcterms:description xml:lang="en">An ion is an atom or molecule in which the total number of electrons is not equal to the total number of protons, giving it a net positive or negative electrical charge.</dcterms:description>
    <dc:identifier>SIO_010456</dc:identifier>
    <owl:equivalentClass rdf:nodeID="N8e1e5f07c92d48e8b86d845db75fd1e8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/ray">
    <rdfs:label xml:lang="en">ray</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/line"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A ray is a line which that is bounded by a startpoint and extends outwards infinitely along one dimension.</dcterms:description>
    <dc:identifier>SIO_000516</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-magnify">
    <dc:identifier>SIO_000345</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">to magnify is the capability to increase the appearance of the size of an object.</dcterms:description>
    <rdfs:label xml:lang="en">to magnify</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-change-appearance"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/time-instant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/time-measurement"/>
    <dcterms:description xml:lang="en">A time instant is a temporal region which occurs instantaneously, e.g. having no duration.</dcterms:description>
    <rdfs:label xml:lang="en">time instant</rdfs:label>
    <skos:example xml:lang="en">at this moment; the moment at which a finger is detached in an industrial accident; the moment at which a child is born; the moment of death</skos:example>
    <dc:identifier>SIO_000418</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/novel">
    <rdfs:label xml:lang="en">novel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A novel is a fictitious prose narrative of book length, typically representing character and action with some degree of realism.</dcterms:description>
    <dc:identifier>SIO_000109</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/publication"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/increased">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/decreased"/>
    <rdfs:label xml:lang="en">increased</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/abnormal"/>
    <ns1:equivalentTo>PATO:0002300</ns1:equivalentTo>
    <dc:identifier>SIO_000640</dc:identifier>
    <dcterms:description xml:lang="en">A quality that has a value that is increased compared to normal or average.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
