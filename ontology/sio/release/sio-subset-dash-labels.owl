    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/nucleophilic-addition-reaction">
    <dcterms:description xml:lang="en">A nucleophilic addition reaction is an addition reaction where a pi bond is removed by the creation of two new covalent bonds by the addition from a nucleophile.</dcterms:description>
    <rdfs:label xml:lang="en">nucleophilic addition reaction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/polar-addition-reaction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010522</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
