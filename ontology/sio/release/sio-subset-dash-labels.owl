  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/bar-graph">
    <skos:example xml:lang="en">Graphs 3,4,5 in http://tinyurl.com/opwnvm</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/statistical-graph"/>
    <dcterms:description xml:lang="en">A bar graph is a statistical graph with rectangular bars of lengths proportional to that value that they represent.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bar graph</rdfs:label>
    <dc:identifier>SIO_000443</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
