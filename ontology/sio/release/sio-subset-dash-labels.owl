    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/ethnicity">
    <dc:identifier>SIO_001014</dc:identifier>
    <rdfs:label xml:lang="en">ethnicity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">ethnicity is the biological quality of membership in a social group based on a common heritage.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-quality"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
