  <rdf:Description rdf:about="http://semanticscience.org/resource/imaginary-number">
    <rdfs:label xml:lang="en">imaginary number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/complex-number"/>
    <dc:identifier>SIO_001441</dc:identifier>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/real-number"/>
    <dcterms:description xml:lang="en">An imaginary number is a complex number whose real part is zero e.g. 0 + bi, and is expressed as a multiple of the square root of -1.</dcterms:description>
    <ns1:example xml:lang="en">5i is an imaginary number, and its square is -25.</ns1:example>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
