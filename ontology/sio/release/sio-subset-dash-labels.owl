  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/double-stranded-nucleic-acid">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/molecular-complex"/>
    <rdfs:subClassOf rdf:nodeID="N4bd63be4b6004a77b89d08a93a8cdff6"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">double stranded nucleic acid is a molecular complex composed of two weakly connected nucleic acids.</dcterms:description>
