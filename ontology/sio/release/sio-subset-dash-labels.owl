  <rdf:Description rdf:about="http://semanticscience.org/resource/has-part">
    <skos:example xml:lang="en">a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;</skos:example>
    <rdfs:label xml:lang="en">has part</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-location-of"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
    <dcterms:description xml:lang="en">has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.</dcterms:description>
    <dc:identifier>SIO_000028</dc:identifier>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-part-of"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/partial-differential-equation">
    <rdfs:label xml:lang="en">partial differential equation</rdfs:label>
    <dcterms:description xml:lang="en">A partial differential equation (PDE) is a differential equation in which the unknown function is a function of multiple independent variables and the equation involves its partial derivatives.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/differential-equation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000568</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-be-observed">
    <dcterms:description xml:lang="en">to be observed is the capability of an object to be perceived.</dcterms:description>
    <rdfs:subClassOf rdf:nodeID="N9071580456574c69b4e116d293026c3d"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-be-passively-interacted-with"/>
