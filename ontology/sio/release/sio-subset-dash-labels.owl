    <rdfs:label xml:lang="en">audio recording</rdfs:label>
    <dcterms:description xml:lang="en">An audio recording is an electrical or mechanical inscription and re-creation of sound waves, such as spoken voice, singing, instrumental music, or sound effects.</dcterms:description>
