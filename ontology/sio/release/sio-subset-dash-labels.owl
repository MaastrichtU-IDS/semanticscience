  <rdf:Description rdf:about="http://semanticscience.org/resource/electrophilic-addition-reaction">
    <dc:identifier>SIO_010523</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/polar-addition-reaction"/>
    <rdfs:label xml:lang="en">electrophilic addition reaction</rdfs:label>
    <dcterms:description xml:lang="en">An electrophilic addition reaction is a polar addition reaction where a pi bond is removed by the creation of two new covalent bonds.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/dose">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/dimensional-quantity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A dose is the quantity of a chemical substance administered to a biological system.</dcterms:description>
    <rdfs:label xml:lang="en">dose</rdfs:label>
    <dc:identifier>SIO_001019</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/love">
    <dc:identifier>SIO_000412</dc:identifier>
    <dcterms:description xml:lang="en">love is an emotion of a strong affection and personal attachment.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/positive-emotion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">love</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/buffer-role">
    <dc:identifier>SIO_000887</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-substance-role"/>
    <rdfs:subClassOf rdf:nodeID="Nc562fdc6a78345e19b9ccc28d288b814"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A buffer role is the role of a chemical substance which maintains a pH at a near constant value.</dcterms:description>
    <rdfs:label xml:lang="en">buffer role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SOAP-web-service">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/web-service"/>
    <rdfs:label xml:lang="en">SOAP web service</rdfs:label>
    <dc:identifier>SIO_001191</dc:identifier>
    <dcterms:description xml:lang="en">a SOAP web service is a web service that implements Simple Object Access Protocol (SOAP).</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/SOAP</rdfs:seeAlso>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/tellurium-atom">
    <skos:exactMatch>CHEBI:30452</skos:exactMatch>
