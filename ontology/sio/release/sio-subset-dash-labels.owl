  <rdf:Description rdf:about="http://semanticscience.org/resource/diagnostic-test">
    <dc:identifier>SIO_001022</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/medical-procedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">clinical laboratory test</dcterms:alternative>
    <rdfs:label xml:lang="en">diagnostic test</rdfs:label>
    <dcterms:description xml:lang="en">A diagnostic test is a procedure performed to confirm, or determine the presence of disease in an individual suspected of having the disease, usually following the report of symptoms, or based on the results of other medical tests.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
