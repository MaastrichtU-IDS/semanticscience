    <ns1:subset>core</ns1:subset>
    <rdfs:label xml:lang="en">is causally related from</rdfs:label>
    <dcterms:description xml:lang="en">a is causally related from b iff there is a causal chain of events from b to a</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/abnormal">
