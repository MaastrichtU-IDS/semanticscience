  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-serve-as-a-template-for-DNA-synthesis">
    <dc:identifier>SIO_010091</dc:identifier>
    <rdfs:label xml:lang="en">to serve as a template for DNA synthesis</rdfs:label>
    <dcterms:description xml:lang="en">to serve as a template for DNA synthesis is the capability of a chemical entity to provide the necessary information or scaffold by which a DNA molecule may be produced.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-serve-as-a-template-for-molecular-synthesis"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-derived-from">
    <ns1:subset>core</ns1:subset>
    <rdfs:label xml:lang="en">is derived from</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-causally-related-from"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/derives-into"/>
    <ns1:equivalentTo>OBO_REL:derives_from</ns1:equivalentTo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000244</dc:identifier>
    <dcterms:description xml:lang="en">A transitive temporal relation in which one entity was materially formed from another non-identical entity.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/frequency">
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <dcterms:description xml:lang="en">Frequency is the number of occurrences of a repeating event per unit time</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/rate-of-change"/>
    <dc:identifier>SIO_001367</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/interval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">An interval is a set of real numbers that includes all numbers between any two numbers in the set.</dcterms:description>
    <dcterms:description xml:lang="en">an interval is a set of real numbers with the property that any number that lies between two numbers in the set is also included in the set.</dcterms:description>
    <dc:identifier>SIO_001246</dc:identifier>
    <dc:identifier>SIO_000944</dc:identifier>
    <rdfs:label xml:lang="en">interval</rdfs:label>
    <skos:example xml:lang="en">The set of all numbers x satisfying 0&lt;=x&lt;=1 is an interval which contains 0 and 1, as well as numbers between them.</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/set"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/mathematical-entity"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/city">
