  <rdf:Description rdf:about="http://semanticscience.org/resource/van-der-Waals-interaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/weak-submolecular-component"/>
    <dc:identifier>SIO_010504</dc:identifier>
    <rdfs:label xml:lang="en">van der Waals interaction</rdfs:label>
    <dcterms:description xml:lang="en">van der Waals' interaction is an a weak submolecular interaction between an instantaneous dipole and induced dipole.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
