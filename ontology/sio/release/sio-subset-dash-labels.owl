  <rdf:Description rdf:about="http://semanticscience.org/resource/to-boil">
    <dcterms:description xml:lang="en">to boil is the capability to increase the internal kinetic energy of a material such that it changes state from a solid or liquid to a gas.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-heat"/>
    <rdfs:label xml:lang="en">to boil</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000373</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
