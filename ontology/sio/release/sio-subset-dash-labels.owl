    <dc:identifier>SIO_010087</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/pharmaceutical-ingredient"/>
    <dcterms:description xml:lang="en">Aninactive ingredient is a molecular entity that does not exhibit biological activity.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
