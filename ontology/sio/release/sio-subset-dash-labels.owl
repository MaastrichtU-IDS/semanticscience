  <rdf:Description rdf:about="http://semanticscience.org/resource/has-creator">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-source"/>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/entity"/>
    <dcterms:alternative xml:lang="en">was created by</dcterms:alternative>
