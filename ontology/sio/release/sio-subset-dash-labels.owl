  <rdf:Description rdf:about="http://semanticscience.org/resource/perception">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/observing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000379</dc:identifier>
    <dcterms:description xml:lang="en">perception is the organization, identification, and interpretation of sensory information in order to fabricate a mental representation through the process of transduction, which sensors in the body transform signals from the environment into encoded neural signals.</dcterms:description>
    <rdfs:label xml:lang="en">perception</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
