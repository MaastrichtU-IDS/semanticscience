  <rdf:Description rdf:about="http://semanticscience.org/resource/parental-transmission">
    <rdfs:label xml:lang="en">parental transmission</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description>parental transmition is the quality of a biological organism in which the (genetic) material is transmitted from a parental unit.</dcterms:description>
