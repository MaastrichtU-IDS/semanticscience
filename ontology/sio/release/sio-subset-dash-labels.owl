    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/catalyst">
    <dcterms:description xml:lang="en">A catalyst is a molecule that has the capability to reduce the activation energy of a reaction and hence increase the overall rate of reaction.</dcterms:description>
