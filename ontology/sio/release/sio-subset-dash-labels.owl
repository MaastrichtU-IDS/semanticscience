  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/negatively-regulates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">negatively regulates</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/regulates"/>
    <dc:description xml:lang="en">x negatively regulates y if and only if x is a process and y is either a process or a quality, and the progression of x exerts an reduced effect on the frequency, rate or extent of y</dc:description>
    <dc:identifier>SIO_001402</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
