  <rdf:Description rdf:about="http://semanticscience.org/resource/synthetic-quality">
    <dc:identifier>SIO_001410</dc:identifier>
    <rdfs:label xml:lang="en">synthetic quality</rdfs:label>
    <dcterms:description xml:lang="en">synthetic quality is the quality of a manufactured object that has similar properties as naturally occuring objects.</dcterms:description>
