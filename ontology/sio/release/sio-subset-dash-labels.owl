    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A Gantt chart is a bar chart that illustrates a project schedule.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chart"/>
    <rdfs:label xml:lang="en">Gantt chart</rdfs:label>
