  <rdf:Description rdf:about="http://semanticscience.org/resource/gene-disease-association-linked-with-susceptibility-mutation">
    <dc:identifier>SIO_001343</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene-disease association linked with susceptibility mutation</rdfs:label>
    <dcterms:description xml:lang="en">A gene-disease association in which a germline mutation in the gene predisposes to the development of the disease, and it is necessary but not sufficient for the manifestation of the disease.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene-disease-association-linked-with-genetic-variation"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
