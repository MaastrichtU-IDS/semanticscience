  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/pharmacodynamic-pathway">
    <dc:identifier>SIO_001256</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a pharmacodynamic pathay is a regulatory pathway in which a drug molecule regulates the activity of one or more components organized in a pathway.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulatory-pathway"/>
    <rdfs:label xml:lang="en">pharmacodynamic pathway</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/image">
    <dc:identifier>SIO_000081</dc:identifier>
    <dcterms:description xml:lang="en">An image is an affine projection of a visual entity to a two dimensional surface.</dcterms:description>
