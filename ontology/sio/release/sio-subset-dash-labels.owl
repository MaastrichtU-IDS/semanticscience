  <rdf:Description rdf:about="http://semanticscience.org/resource/tree-diagram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/directed-acyclic-graph"/>
    <rdfs:label xml:lang="en">tree diagram</rdfs:label>
    <dcterms:description xml:lang="en">A tree diagram is a hierarchical network diagram in which a root vertex is connected to one or more other vertices through a directed edge, which in turn may be connected to other vertices.</dcterms:description>
    <dc:identifier>SIO_000945</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
