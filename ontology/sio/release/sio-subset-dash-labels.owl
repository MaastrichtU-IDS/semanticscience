  <rdf:Description rdf:about="http://semanticscience.org/resource/second-messenger">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/messenger"/>
    <dc:identifier>SIO_010440</dc:identifier>
    <rdfs:label xml:lang="en">second messenger</rdfs:label>
    <dcterms:description xml:lang="en">A second messenger is a molecule that relay signals from receptors on the cell surface to target molecules inside the cell, in the cytoplasm or nucleus. </dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
