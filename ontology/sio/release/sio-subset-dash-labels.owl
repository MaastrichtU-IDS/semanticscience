  <rdf:Description rdf:about="http://semanticscience.org/resource/process">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/entity"/>
    <rdfs:subClassOf rdf:nodeID="N95b04e05117e4cd082afb2f10705634e"/>
