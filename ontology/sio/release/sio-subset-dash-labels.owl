    <rdfs:subClassOf rdf:nodeID="N1a03bf004fa745b8a26015f9d894386c"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/model"/>
    <dc:identifier>SIO_000647</dc:identifier>
    <dcterms:description xml:lang="en">A process model is a representation of some process.</dcterms:description>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/object-model"/>
    <rdfs:label xml:lang="en">process model</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
