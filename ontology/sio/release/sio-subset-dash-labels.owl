    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/monosaccharide"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/supernatant">
    <rdfs:label xml:lang="en">supernatant</rdfs:label>
    <dcterms:description xml:lang="en">A supernatent is a liquid substance that remains after centrifugation.</dcterms:description>
    <dc:identifier>SIO_010425</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/centrifugation-substance"/>
