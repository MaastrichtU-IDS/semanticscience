    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">An insertion variant role is the role of an sequence that contains a sub-sequence that is considered to be an addition relative to the frame of reference.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/homonym">
    <rdfs:subClassOf rdf:nodeID="Nee99777fe38f4a34a8e4d55fc71d7d94"/>
