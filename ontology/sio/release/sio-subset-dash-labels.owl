  <rdf:Description rdf:about="http://semanticscience.org/resource/process-up-regulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">positive regulation</dcterms:alternative>
    <dc:identifier>SIO_010295</dc:identifier>
    <dcterms:description xml:lang="en">process up-regulation is a process that increases the frequency, rate or extent of one or more processes in relation to a reference state.</dcterms:description>
    <rdfs:label xml:lang="en">process up-regulation</rdfs:label>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/process-down-regulation"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
