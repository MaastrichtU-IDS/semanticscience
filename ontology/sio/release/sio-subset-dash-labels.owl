  <rdf:Description rdf:about="http://semanticscience.org/resource/has-unit">
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/mathematical-entity"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns1:subset>core</ns1:subset>
    <dcterms:description xml:lang="en">has unit is a relation between a quantity and the unit it is a multiple of.</dcterms:description>
    <rdfs:range rdf:resource="http://semanticscience.org/resource/unit-of-measurement"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-unit-of"/>
