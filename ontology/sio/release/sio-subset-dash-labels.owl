  <rdf:Description rdf:about="http://semanticscience.org/resource/exists-at">
    <dcterms:description xml:lang="en">exists at is a relation between an entity and a time measurement.</dcterms:description>
    <ns1:subset>core</ns1:subset>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000687</dc:identifier>
    <rdfs:label xml:lang="en">exists at</rdfs:label>
    <rdfs:range rdf:resource="http://semanticscience.org/resource/time-measurement"/>
