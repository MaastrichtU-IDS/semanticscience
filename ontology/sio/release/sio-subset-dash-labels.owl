  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/medical-data">
    <rdfs:label xml:lang="en">medical data</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-data"/>
    <dcterms:description xml:lang="en">medical data is data of interest to medicine.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010298</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/union">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/list"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/intersection"/>
    <rdfs:label xml:lang="en">union</rdfs:label>
    <dc:identifier>SIO_001116</dc:identifier>
    <dcterms:description xml:lang="en">A union is a list of all of the values of an attribute for the entities in the defined set.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/healthy">
    <dc:identifier>SIO_001012</dc:identifier>
    <rdfs:label xml:lang="en">healthy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/alive"/>
    <dcterms:description xml:lang="en">healthy is an organismal state of complete physical, mental and social well-being.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/telephone-number">
    <rdfs:label xml:lang="en">telephone number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001319</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/informational-entity-identifier"/>
    <dcterms:description>a telephone number is an identifier used to connect to a physical device capable of transfering voice or data over a network.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-covalently-connected-to-%28transitive%29">
    <dc:identifier>SIO_000288</dc:identifier>
    <rdfs:range rdf:resource="http://semanticscience.org/resource/atom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/atom"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-connected-to"/>
    <rdfs:label xml:lang="en">is covalently connected to (transitive)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/design">
    <rdfs:label xml:lang="en">design</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/functional-specification"/>
    <dc:identifier>SIO_000705</dc:identifier>
    <dcterms:description xml:lang="en">A specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/disposition">
    <rdfs:subClassOf rdf:nodeID="Nb0c58240984c476796758cd810dc2fea"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/capability"/>
    <ns1:subset>core</ns1:subset>
    <dc:identifier>SIO_000014</dc:identifier>
    <rdfs:label xml:lang="en">disposition</rdfs:label>
    <dcterms:description xml:lang="en">A disposition is the tendency of a capability to be exhibited under certain conditions or in response to a certain stimulus (trigger).</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">solubility (to dissolve when put in fluid); fragility (disposition to break when dropped)</skos:example>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/polygon">
    <rdfs:label xml:lang="en">polygon</rdfs:label>
    <dcterms:description xml:lang="en">A polygon is a planar entity that is bounded by a closed path or circuit, composed of a finite connected sequence3 of straight line segments.</dcterms:description>
    <dc:identifier>SIO_000505</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/geometric-entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/example">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:identifier>example</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/organic-reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-reaction"/>
    <dc:identifier>SIO_010516</dc:identifier>
    <rdfs:label xml:lang="en">organic reaction</rdfs:label>
    <dcterms:description xml:lang="en">An organic reaction is a chemical reaction involving at least one organic molecule.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-filter">
    <dcterms:description xml:lang="en">to filter is the capability to retain certain entities based on selected attribute(s) while allowing other entities to pass through.</dcterms:description>
    <rdfs:label xml:lang="en">to filter</rdfs:label>
    <dc:identifier>SIO_000382</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-separate"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/written-language">
    <dc:identifier>SIO_000982</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/language"/>
    <rdfs:label xml:lang="en">written language</rdfs:label>
    <dcterms:description xml:lang="en">written language is a language that is communicated through a writing system.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/software-module">
    <dc:identifier>SIO_000099</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">software module</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/software-entity"/>
    <dcterms:description xml:lang="en">A software module is software composed of a collection of software methods.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-annotation-of">
    <dcterms:description xml:lang="en">is annotation of is a relation between some textual entity and the entity that it annotates.</dcterms:description>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/language-entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000254</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-attribute-of"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/has-annotation"/>
    <rdfs:label xml:lang="en">is annotation of</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/hurt">
    <dc:identifier>SIO_000845</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/negative-emotion"/>
    <dcterms:description xml:lang="en">hurt is an unpleasant feeling, emotion or sensation.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hurt</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/chemical-identifier">
    <rdfs:label xml:lang="en">chemical identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A chemical identifier is an identifier for a chemical entity</dcterms:description>
    <dc:identifier>SIO_000728</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/physical-entity-identifier"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/ordered-list-item">
    <dcterms:description>an ordered list item is an item in an ordered list.</dcterms:description>
    <dc:identifier>SIO_001261</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/list-item"/>
    <rdfs:subClassOf rdf:nodeID="Nc19e1cce21134b0187acf004a9377c14"/>
    <rdfs:label xml:lang="en">ordered list item</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/process-maintenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001132</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process"/>
    <dcterms:description xml:lang="en">The process of maintaining some the frequency, rate or extent of another process.</dcterms:description>
    <rdfs:label xml:lang="en">process maintenance</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/negative">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/assertional-qualifier"/>
    <rdfs:label xml:lang="en">negative</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">negative is an assertional qualifier that expresses the falsity or lack of truth of a basic assertion.</dcterms:description>
    <dc:identifier>SIO_001211</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/has-substrate">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-target"/>
    <rdfs:label xml:lang="en">has substrate</rdfs:label>
    <dcterms:description xml:lang="en">has substrate is a relation between a process and an object where the object is destroyed by its participation in the process.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000905</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/agreement">
    <dcterms:description xml:lang="en">agreement is the result of consensus decision making when members of the group agree.</dcterms:description>
    <rdfs:label xml:lang="en">agreement</rdfs:label>
    <dc:identifier>SIO_000966</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/agreement-quality"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/disagreement"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2b57953ede7f42b9966388481f8baa94">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/is-transcribed-from"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/deoxyribonucleic-acid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-output-of">
    <rdfs:label xml:lang="en">is output of</rdfs:label>
    <dcterms:description xml:lang="en">is output of is a relation between an entity and a process, where the entity is present at the end of the process.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-participant-in"/>
    <ns1:subset xml:lang="en">sadi</ns1:subset>
    <dc:identifier>SIO_000232</dc:identifier>
    <skos:example xml:lang="en">glucose-6-phosphate and ADP are outputs in the hexokinase-mediated conversion of glucose to glucose-6-phosphate.</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4a2215cec5b6440c97e714a698997ccf">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://semanticscience.org/resource/information-content-entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/biopolymer">
    <dc:identifier>SIO_000092</dc:identifier>
    <rdfs:subClassOf rdf:nodeID="Nef73b1e9fab34a1a8082d61a5e628b3c"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organic-polymer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">biopolymer</rdfs:label>
    <owl:equivalentClass rdf:nodeID="Ne13ab65539094ed8ac22635e03446658"/>
    <dcterms:description xml:lang="en">A biopolymer is an organic polymer that are typically produced by the cells of living organisms.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/chemical-degradation-pathway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-reaction-pathway"/>
    <dc:identifier>SIO_010528</dc:identifier>
    <dcterms:description xml:lang="en">A chemical degradation pathway is a pathway involved in the disassembly of a chemical.</dcterms:description>
    <rdfs:label xml:lang="en">chemical degradation pathway</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/symbolic-sequence">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/data-item"/>
    <rdfs:label xml:lang="en">symbolic sequence</rdfs:label>
    <dc:identifier>SIO_001447</dc:identifier>
    <rdfs:comment xml:lang="en">A symbolic sequence is a data item that encodes a finite, ordered list of symbols drawn from a specified alphabet, where the identity and position of each symbol are essential to the meaning of the sequence.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/regulation-of-process">
    <rdfs:subClassOf rdf:nodeID="Nef2eb82cba244acb9070342fc656eeb2"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulating"/>
    <dcterms:description xml:lang="en">regulation of a process is a process that modulates the duration, frequency, spatial extent of a target process.</dcterms:description>
    <rdfs:label xml:lang="en">regulation of process</rdfs:label>
    <dc:identifier>SIO_000609</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N415aa3923dcc4e25ab99633486add07e"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/increased-frequency-of-process-from-increased-regulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process-frequency"/>
    <dc:identifier>SIO_001133</dc:identifier>
    <rdfs:label xml:lang="en">increased frequency of process from increased regulation</rdfs:label>
    <dcterms:description xml:lang="en">The increase of regulation leads to a increased occurence of processes of the target type.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/awe">
    <dcterms:description xml:lang="en">awe is an emotion produced by that which is grand, sublime or powerful and is characterized by a combination of joy, fear and admiration/reverence/respect. </dcterms:description>
    <rdfs:label xml:lang="en">awe</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/positive-emotion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000818</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/data-transformation">
    <rdfs:subClassOf rdf:nodeID="Ndba7fd56b374445a9a0650b42aea8311"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/information-processing"/>
    <rdfs:subClassOf rdf:nodeID="N0f7fda250c814e558f22d1edff6aec30"/>
    <dc:identifier>SIO_000594</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">data transformation is the process of applying an algorithmic procedure to some input data and producing some output data.</dcterms:description>
    <rdfs:label xml:lang="en">data transformation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
