  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/discussion-section">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000195</dc:identifier>
    <rdfs:label xml:lang="en">discussion section</rdfs:label>
    <dcterms:description xml:lang="en">The discussion section is a document section containing a summary of the findings, a reflection on the significance of findings, comparison with related work, among others.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/document-section"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/reasoning">
    <dc:identifier>SIO_000746</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/creating"/>
