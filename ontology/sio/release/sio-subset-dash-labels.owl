  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/nurse">
    <rdfs:label xml:lang="en">nurse</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/medical-practitioner"/>
    <rdfs:subClassOf rdf:nodeID="Nebac9ab3ad66451d8f83c208c5ed8c77"/>
    <dcterms:description xml:lang="en">A nurse is an individual that is involved in the protection, promotion, and optimization of health and abilities, prevention of illness and injury, alleviation of suffering through the diagnosis and treatment of human response, and advocacy in the care of individuals, families, communities, and populations.</dcterms:description>
    <dc:identifier>SIO_000398</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N44650f0c4faf4437993c3f4f82b8172d">
    <rdf:first rdf:nodeID="N92e1c7de27cc498299b8207b13a2b543"/>
    <rdf:rest rdf:nodeID="N5778b048be4c44cf8d2a4f7a54619dc0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/apartment-number">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000768</dc:identifier>
    <rdfs:label xml:lang="en">apartment number</rdfs:label>
    <dcterms:description xml:lang="en">An apartment number is the number assigned to identify an apartment in a building of apartments.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/positional-identifier"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/agreement-quality">
    <dc:identifier>SIO_000965</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/informational-quality"/>
    <rdfs:label xml:lang="en">agreement quality</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N5f2a20078cba40d9a2910e74fda7054e"/>
    <dcterms:description xml:lang="en">agreement quality is a quality that exhibits the degree of consensus for some set of assertions.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/disease">
    <rdfs:label xml:lang="en">disease</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">disease is the outward manifestation of one or more disorders.</dcterms:description>
    <rdfs:subClassOf rdf:nodeID="N6503f341d147464e9344360ceb50f9e6"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-quality"/>
    <dc:identifier>SIO_010299</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7262703207314e6ea5de90f68e7c4035">
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/chemical-destruction"/>
