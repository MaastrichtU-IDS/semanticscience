    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/atom"/>
    <skos:exactMatch>CHEBI:27998</skos:exactMatch>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/regulation-of-process-duration">
    <dc:identifier>SIO_001136</dc:identifier>
    <rdfs:label xml:lang="en">regulation of process duration</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process"/>
    <dcterms:description xml:lang="en">regulation of a process duration is a process that modulates the duration of another process relative to some reference process.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/geolegal-region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000413</dc:identifier>
    <dcterms:description xml:lang="en">A geolegal region is a geographic region which has causal powers confered by a legal entity.</dcterms:description>
    <skos:example xml:lang="en">The 50 kph zones in Ottawa; the geographic region occupied by France.</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/geographic-region"/>
    <rdfs:label xml:lang="en">geolegal region</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
