  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/minor-version-number">
    <dcterms:description xml:lang="en">A minor version number is a version of a software that exhibits minor features or significant fix from a prior version.</dcterms:description>
    <rdfs:label xml:lang="en">minor version number</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/software-version-label"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001031</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
