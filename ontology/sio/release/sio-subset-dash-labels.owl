  <rdf:Description rdf:about="http://semanticscience.org/resource/is-specialization-of">
    <dcterms:description xml:lang="en">is specialization of is a relation between a more specific instance (in terms of spatial/temporal localization &amp; other attributres) than the other.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-variant-of"/>
    <skos:example xml:lang="en">a weather forecast for the city of London produced at a specific time is a specialization of a weather forecast for the city of London.</skos:example>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-generalization-of"/>
    <rdfs:label xml:lang="en">is specialization of</rdfs:label>
    <dc:identifier>SIO_001096</dc:identifier>
    <ns1:equivalentTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/ns/prov#specializationOf</ns1:equivalentTo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/comparing">
    <dcterms:alternative>comparison</dcterms:alternative>
    <rdfs:subClassOf rdf:nodeID="Nf5cce72037574ee0baab4710f29c8022"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/interacting"/>
    <dc:identifier>SIO_000745</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">comparing is the process of examining a set of objects and determining their equality or inequality based on one or more features.</dcterms:description>
    <rdfs:label xml:lang="en">comparing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/test-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A test role is the role of an individual that is a participant in the study and is the target of the intervention.</dcterms:description>
    <rdfs:label xml:lang="en">test role</rdfs:label>
