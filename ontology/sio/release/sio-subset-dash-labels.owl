  <rdf:Description rdf:about="http://semanticscience.org/resource/inhibitor">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/molecular-regulator"/>
    <dc:identifier>SIO_010435</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A molecular inhibitor is a molecular regulator that realizes its disposition to conformationally change a target molecule and decrease its functionality.</dcterms:description>
    <rdfs:label xml:lang="en">inhibitor</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/patent">
    <rdfs:label xml:lang="en">patent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/legal-document"/>
    <dcterms:description xml:lang="en">A patent is an information entity granted by a patent issuing authority which confers upon the patenter the sole right to make, use and sell an invention for a set period of time.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000153</dc:identifier>
