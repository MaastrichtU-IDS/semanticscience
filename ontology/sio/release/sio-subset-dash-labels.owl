  <rdf:Description rdf:about="http://semanticscience.org/resource/software-version-label">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/version-label"/>
    <rdfs:subClassOf rdf:nodeID="N8c8b64764fbc4e79aaa0b4182789f9fa"/>
    <dcterms:description xml:lang="en">A software version label is a version label for a piece of software.</dcterms:description>
