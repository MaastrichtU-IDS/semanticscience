    <rdfs:label xml:lang="en">cation pi interaction</rdfs:label>
    <dc:identifier>SIO_010034</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A cation pi interaction is an ionic interaction between the localized negative charge of π orbital electrons, located above and below the plane of an aromatic ring, and a positive charge.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/ionic-interaction"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
