  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/site">
    <dc:identifier>SIO_000019</dc:identifier>
    <skos:example xml:lang="en">A nostril; the interior of the heart valve; the interior of a bottle.</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/spatial-region"/>
    <rdfs:label xml:lang="en">site</rdfs:label>
    <dcterms:description xml:lang="en">A site is a spatial region bounded (in part or in whole) by material entities and may be occupied by material entities.</dcterms:description>
