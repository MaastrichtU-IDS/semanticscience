  <rdf:Description rdf:about="http://semanticscience.org/resource/antibody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010465</dc:identifier>
    <dcterms:description xml:lang="en">An antibody (also known as immunoglobulins, abbreviated Ig) are gamma globulin proteins that are used by the immune system to identify and neutralize foreign objects. They are typically made of two large heavy chains and two small light chains.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/protein-complex"/>
    <rdfs:label xml:lang="en">antibody</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
