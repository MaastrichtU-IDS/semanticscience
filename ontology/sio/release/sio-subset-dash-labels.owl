    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/decrease-in-number-of-objects-produced">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/difference-in-number-of-objects-produced"/>
    <rdfs:label xml:lang="en">decrease in number of objects produced</rdfs:label>
    <dc:identifier>SIO_001164</dc:identifier>
    <dcterms:description xml:lang="en">An decrease in the number of objects produced is the negative value of a difference in number of objects produced.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/slide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A slide is an visual representation meant to communicate some information.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/media"/>
    <dc:identifier>SIO_001370</dc:identifier>
    <rdfs:label xml:lang="en">slide</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/secretary-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/administrative-role"/>
    <dcterms:description xml:lang="en">A secretary role is the role of an individual that performs administrative tasks to support one or more individuals of the same organization.</dcterms:description>
    <dc:identifier>SIO_000727</dc:identifier>
    <rdfs:label xml:lang="en">secretary role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/quantile">
    <dcterms:description xml:lang="en">A quantile is a quantity that divides the range of a probability distribution into continuous intervals with equal probabilities, or dividing the observations in a sample in the same way.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quantile</rdfs:label>
    <dc:identifier>SIO_001414</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/dimensionless-quantity"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/parameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A parameter is variable whose value changes the characteristics of a system or a function.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/independent-variable"/>
    <rdfs:label xml:lang="en">parameter</rdfs:label>
