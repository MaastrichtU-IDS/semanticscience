  <rdf:Description rdf:about="http://semanticscience.org/resource/circumference">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/length-of-perimeter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">circumference is the length of the outline of a circle or ellipse. it is defined as c = 2*pi*r, where r is the radius.</dcterms:description>
