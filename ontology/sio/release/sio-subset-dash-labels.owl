  <rdf:Description rdf:about="http://semanticscience.org/resource/mouse">
    <dcterms:description xml:lang="en">A mouse is a small mammal belonging to the order of rodents, characteristically having a pointed snout, small rounded ears, and a long naked or almost hairless tail. </dcterms:description>
