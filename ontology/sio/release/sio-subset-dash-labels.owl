  <rdf:Description rdf:about="http://semanticscience.org/resource/non-polar-addition-reaction">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/addition-reaction"/>
    <dcterms:description xml:lang="en">A non-polar addition reaction is an addition reaction involving non-polar residues.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">non-polar addition reaction</rdfs:label>
