  <rdf:Description rdf:about="http://semanticscience.org/resource/predicted">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/hypothetical"/>
    <rdfs:label xml:lang="en">predicted</rdfs:label>
    <dcterms:description xml:lang="en">predicted is the quality of an entity that is thought to exist, as evidenced by some rational procedure.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000036</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
