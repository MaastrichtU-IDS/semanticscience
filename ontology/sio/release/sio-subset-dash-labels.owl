  <rdf:Description rdf:about="http://semanticscience.org/resource/referencing-cell">
    <dc:identifier>SIO_000760</dc:identifier>
    <dcterms:description xml:lang="en">A referenceing cell is a cell of a cellular automata that refers to another cell.</dcterms:description>
