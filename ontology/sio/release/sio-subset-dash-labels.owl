  <rdf:Description rdf:about="http://semanticscience.org/resource/mRNA-splice-variant">
    <rdfs:label xml:lang="en">mRNA splice variant</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N46437b4384374e5aa9d3b92b452a142b"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/messenger-RNA"/>
    <dcterms:description xml:lang="en">An mRNA splice variant is an mRNA molecule that varies from another mRNA molecule of the same gene origin but having a different final sequence due to differences in its assembly from splice sites.</dcterms:description>
    <dc:identifier>SIO_010098</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
