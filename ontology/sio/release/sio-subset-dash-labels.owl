    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/organization">
    <dcterms:description xml:lang="en">An organization is a collective with a complex articulation of tasks, roles and responsibilities.</dcterms:description>
