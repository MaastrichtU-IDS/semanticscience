    <rdfs:label xml:lang="en">to interact with</rdfs:label>
    <dc:identifier>SIO_000701</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
