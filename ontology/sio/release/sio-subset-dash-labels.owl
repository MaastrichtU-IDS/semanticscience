    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/street-name">
    <dcterms:description xml:lang="en">A street name is the token given to identify a particular street.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/positional-identifier"/>
    <rdfs:label xml:lang="en">street name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000766</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/curvature">
    <dcterms:description xml:lang="en">curvature is a quality of a bearer that relates to the presence of curves, bends, or angles.</dcterms:description>
    <dc:identifier>SIO_000537</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/shape"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">curvature</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/verbal-language-entity">
    <rdfs:label xml:lang="en">verbal language entity</rdfs:label>
    <dc:identifier>SIO_000786</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/language-entity"/>
    <dcterms:description xml:lang="en">A verbal language entity is a language entity that is manifested through sound.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/replica-quality">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/object-relational-quality"/>
    <dcterms:description xml:lang="en">replica quality is the quality of an object that is an exact copy of another object.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001412</dc:identifier>
    <rdfs:label xml:lang="en">replica quality</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N663784fe565f4427a394ea1db0c161eb">
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-part"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/hydrogen-atom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-parameter-in">
    <dcterms:description xml:lang="en">is parameter in is a relation between a data item and some data transformation process.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-input-in"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000553</dc:identifier>
    <rdfs:label xml:lang="en">is parameter in</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
