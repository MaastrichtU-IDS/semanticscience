  <rdf:Description rdf:about="http://semanticscience.org/resource/small-nucleolar-RNA-%28snoRNA%29-gene">
    <dc:identifier>SIO_001229</dc:identifier>
    <rdfs:subClassOf rdf:nodeID="N5eb5dc9054104e399edfc5a557298af2"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/non-protein-coding-RNA-%28ncRNA%29-gene"/>
    <ns1:equivalentTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/SO_0001267</ns1:equivalentTo>
    <rdfs:label xml:lang="en">small nucleolar RNA (snoRNA) gene</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A small nucleolar RNA (snoRNA) gene is a gene that encodes a small RNA that are associated with the eukaryotic nucleus as components of small nucleolar ribonucleoproteins.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/5%27-untranslated-region">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene-component"/>
    <dc:identifier>SIO_010064</dc:identifier>
    <rdfs:label xml:lang="en">5' untranslated region</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">The five prime untranslated region (5' UTR) is a section of messenger RNA (mRNA) and the DNA that codes for it that starts at the +1 position (where transcription begins) and ends one nucleotide before the start codon (usually AUG) of the coding region.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N706ca18619bb4841a4457b08cb90ac09">
    <rdf:first rdf:nodeID="N7f679f9193644dcf9501dc7c300a8a45"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-provider-of">
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/has-provider"/>
    <dc:identifier>SIO_000064</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-source-of"/>
    <dcterms:description xml:lang="en">is provider of is a relation between a source and the entity it makes available.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is provider of</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/loneliness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">loneliness</rdfs:label>
    <dcterms:description xml:lang="en">Loneliness is an unpleasant emotion in which a person feels a strong sense of emptiness, yearning distress and solitude resulting from inadequate quantity or quality of social relationships.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/negative-emotion"/>
    <dc:identifier>SIO_000852</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/secondary-title">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/title"/>
    <dc:identifier>SIO_000471</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">secondary title</rdfs:label>
    <dcterms:alternative>subtitle, alternative title</dcterms:alternative>
    <dcterms:description xml:lang="en">A secondary title is a title of lesser importance that should be used after the first title in describing some entity.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/observing">
    <rdfs:subClassOf rdf:nodeID="Nefa125c7f3fa409f8f464aaa5562bfcd"/>
    <rdfs:subClassOf rdf:nodeID="Nb9c07fb09d65402ba5d2fdd7210a8f25"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/interacting"/>
    <dc:identifier>SIO_001055</dc:identifier>
    <dcterms:alternative xml:lang="en">observation</dcterms:alternative>
    <dcterms:description xml:lang="en">observing is a process of passive interaction in which one entity makes note of attributes of one or more entities.</dcterms:description>
    <rdfs:label xml:lang="en">observing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/displacement-reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">displacement reaction</rdfs:label>
    <dc:identifier>SIO_010512</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/inorganic-reaction"/>
    <dcterms:description xml:lang="en">A displacement reaction is an inorganic reaction in which a elementary substance displaces and sets free a constituent atom from a molecule.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/control-variable">
    <dc:identifier>SIO_001070</dc:identifier>
    <dcterms:alternative>controlled variable</dcterms:alternative>
    <dcterms:alternative>extraneous variable</dcterms:alternative>
    <dcterms:description xml:lang="en">A control variable that is believed to alter the dependent or independent variables, but may not actually be the focus of the experiment. So that variable will be kept constant or monitored to try to minimise its effect on the experiment.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/variable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">control variable</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/catalytic-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">catalytic role</rdfs:label>
    <dc:identifier>SIO_000796</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulator-role"/>
    <dcterms:description xml:lang="en">The role of a chemical participant that serves to increase the rate of reaction by lowering the activiation energy.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/legal-name">
    <dcterms:description xml:lang="en">A legal name is a name given at birth, or which appears on their birth certificate, marriage certificate, or change of name certificate.</dcterms:description>
    <dc:identifier>SIO_000184</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">legal name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/personal-name"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
