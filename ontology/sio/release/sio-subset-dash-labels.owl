  <rdf:Description rdf:about="http://semanticscience.org/resource/amino-acid-residue">
    <rdfs:label xml:lang="en">amino acid residue</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N60430b1277fe413dba0cba4b3fd7bc1b"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/amino-acid-polymer-submolecule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">An amino acid residue is a submolecule of an amino acid that is part of a larger molecule.</dcterms:description>
    <dc:identifier>SIO_010074</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/process-down-regulation">
    <rdfs:label xml:lang="en">process down-regulation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">process down-regulation is a process that decreases the frequency, rate or extent of one or more processes in relation to a reference state.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process"/>
    <dcterms:alternative xml:lang="en">negative regulation</dcterms:alternative>
    <dc:identifier>SIO_010296</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/data-collection-device">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/device"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A data collection device is a device that collects information about one or more objects.</dcterms:description>
    <rdfs:label xml:lang="en">data collection device</rdfs:label>
    <dc:identifier>SIO_001236</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/fullerene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fullerene</rdfs:label>
    <dcterms:description xml:lang="en">fullerene is a carbon allotrope which take the form of a hollow sphere, ellipsoid, or tube.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/carbon-allotrope"/>
    <dc:identifier>SIO_010789</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/denotes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:description xml:lang="en">denotes is a relation between an entity and what it is a sign or indication of, or what specifically means.</dcterms:description>
    <dc:identifier>SIO_000020</dc:identifier>
    <rdfs:label xml:lang="en">denotes</rdfs:label>
    <skos:example xml:lang="en">the symbol '%' denotes a proportion in relation to a whole.</skos:example>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/represents"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-denoted-by"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/chemical-effect">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-interaction"/>
    <rdfs:subClassOf rdf:nodeID="Nde2d82caa9024e49914de41392d3ac0c"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A chemical effect is a chemical interaction in which a chemical elicits a marked characteristic of a biological system.</dcterms:description>
    <dc:identifier>SIO_001005</dc:identifier>
    <rdfs:label xml:lang="en">chemical effect</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/collection-ovopub">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/ovopub"/>
    <rdfs:label xml:lang="en">collection ovopub</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A collection ovopub is an ovopub that contains and links to one or more assertion subgraphs and/or ovopubs, as well as statements describing its provenance. It is used to share a specific set of items or restrict a search to the resources contained therein.</dcterms:description>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/assertion-ovopub"/>
    <dc:identifier>SIO_001301</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/microarray-device">
    <dcterms:description xml:lang="en">A microarray device is a device that identifies the binding of a target substance to a physically immobile substrate placed in an array or lattice.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/data-collection-device"/>
    <rdfs:label xml:lang="en">microarray device</rdfs:label>
    <dc:identifier>SIO_001238</dc:identifier>
    <ns1:similarTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/OBI_0000052</ns1:similarTo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">microarray platform</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
