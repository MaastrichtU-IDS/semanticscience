  <rdf:Description rdf:about="http://semanticscience.org/resource/is-inequal-to">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is inequal to</rdfs:label>
    <dcterms:description xml:lang="en">is inequal to is a comparison relation between two quantities whose value are not the same.</dcterms:description>
    <dc:identifier>SIO_000749</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-numerically-comparable-to"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/concentration">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/3D-extent-quantity"/>
    <rdfs:subClassOf rdf:nodeID="N888f670a718349f89db93e73251b4e21"/>
    <dc:identifier>SIO_001088</dc:identifier>
    <rdfs:label xml:lang="en">concentration</rdfs:label>
    <dcterms:description xml:lang="en">concentration is the amount of substance per unit volume of a solution</dcterms:description>
