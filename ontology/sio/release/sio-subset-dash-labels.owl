  <rdf:Description rdf:about="http://semanticscience.org/resource/software-application">
    <rdfs:label xml:lang="en">software application</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/software-entity"/>
    <dcterms:description xml:lang="en">A software application is software that can be directly executed by some processing unit.</dcterms:description>
