  <rdf:Description rdf:about="http://semanticscience.org/resource/single-nucleotide-polymorphism">
    <dc:identifier>SIO_001329</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">SNV</dcterms:alternative>
    <dcterms:alternative xml:lang="en">SNP</dcterms:alternative>
