    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-supply-energy"/>
    <dc:identifier>SIO_000346</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/thesis-document">
    <rdfs:label xml:lang="en">thesis document</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/publication"/>
    <dcterms:description xml:lang="en">A thesis document is the written research component of a post-secondary institution  that contains a statement supported by arguments.</dcterms:description>
    <dc:identifier>SIO_000165</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-refuting-evidence-for">
    <dc:identifier>SIO_000775</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-evidence-for"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is refuting evidence for</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/stereoisomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A stereoisomer is an isomer in which the atomic connectivity is the same, but differs in its spatial arrangement of atoms.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/isomer"/>
    <dc:identifier>SIO_010775</dc:identifier>
    <rdfs:label xml:lang="en">stereoisomer</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/race">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-quality"/>
    <dcterms:description xml:lang="en">race is a characteristic of an individual by heritable phenotypic characteristics, geographic ancestry, physical appearance, ethnicity, and social status.</dcterms:description>
    <rdfs:label xml:lang="en">race</rdfs:label>
    <dc:identifier>SIO_001015</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/molecular-tracer-role">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/reactant-role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">molecular tracer role</rdfs:label>
    <dc:identifier>SIO_000896</dc:identifier>
    <dcterms:description xml:lang="en">A molecular tracer role is a reactant role of a molecular entity that serves as a marker for the presence, abundance, or location of a molecular target that it associates with.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/line-graph">
    <dcterms:description xml:lang="en">A line graph is a statistical graph in which lines contains the evaluation of functions or individual points connected by line segments.</dcterms:description>
    <dc:identifier>SIO_000442</dc:identifier>
    <rdfs:label xml:lang="en">line graph</rdfs:label>
    <skos:example xml:lang="en">Graph 1 in http://tinyurl.com/opwnvm</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/statistical-graph"/>
    <dcterms:alternative xml:lang="en">line chart</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/atom">
    <rdfs:label xml:lang="en">atom</rdfs:label>
    <dc:identifier>SIO_010044</dc:identifier>
    <dcterms:description xml:lang="en">An atom is composed of a core of protons and/or neutrons which may be surrounded by a cloud of electrons.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-entity"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/variant-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000479</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/comparative-role"/>
    <dcterms:description xml:lang="en">A variant role is a comparative role in which the value of an attribute differs when compared to another entity</dcterms:description>
    <rdfs:label xml:lang="en">variant role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/open-interval">
    <skos:example xml:lang="en">(0,1) is an open interval that is greater than 0 and less than 1.</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/left-open-interval"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/right-open-interval"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">an open interval is an interval that does not include its endpoints.</dcterms:description>
    <rdfs:label xml:lang="en">open interval</rdfs:label>
    <dc:identifier>SIO_001248</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/differential-diagnosis">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/medical-procedure"/>
    <rdfs:label xml:lang="en">differential diagnosis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A differential diagnosis (sometimes abbreviated DDx, ddx, DD, D/Dx, or ΔΔ) is a systematic diagnostic method used to identify the presence of an entity where multiple alternatives are possible (and the process may be termed differential diagnostic procedure), and may also refer to any of the included candidate alternatives (which may also be termed candidate condition).</dcterms:description>
    <dc:identifier>SIO_001002</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/date-of-database-submission">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/time-instant"/>
    <dcterms:description xml:lang="en">A date of database submission refers to the moment in time in which some information was submitted/received to a database system.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">date of database submission</rdfs:label>
    <dc:identifier>SIO_001083</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/width">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/1D-extent-quantity"/>
    <dc:identifier>SIO_000042</dc:identifier>
    <rdfs:label xml:lang="en">width</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">width is the shorter dimensional extent perpendicular to a 2D projection of the object.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/radar">
    <dc:identifier>SIO_000928</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/device"/>
    <rdfs:label xml:lang="en">radar</rdfs:label>
    <dcterms:description xml:lang="en">A radar is an object-detection system which uses radio waves to determine the range, altitude, direction, or speed of objects.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-equal-to">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-numerically-comparable-to"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:description xml:lang="en">is equal to is a comparison relation between two quantities whose value are exactly the same.</dcterms:description>
    <dc:identifier>SIO_000738</dc:identifier>
    <rdfs:label xml:lang="en">is equal to</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/postal-code">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">postal code</rdfs:label>
    <dcterms:description xml:lang="en">A postal code is a geographic coordinate composed of a series of letters and/or digits appended to a postal address for the purpose of sorting mail.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/geographic-position"/>
    <dc:identifier>SIO_000767</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/word-start-position">
    <dc:identifier>SIO_001057</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">word start position</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nf18a578591a44102aa5bda2c7cf560df"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/text-span-start-position"/>
    <dcterms:description xml:lang="en">The position of the first character in a word as an offset from the first character of the text in which it is found.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/cellular-organism">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A cellular organism is an organism that contains one or more cells.</dcterms:description>
    <dc:identifier>SIO_010377</dc:identifier>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/non-cellular-organism"/>
    <rdfs:label xml:lang="en">cellular organism</rdfs:label>
    <owl:equivalentClass rdf:nodeID="N3b2aa1bc3ed943a39f9384425010a2c4"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/regulation-of-object-consumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001150</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-object-quantity"/>
    <dcterms:description xml:lang="en">A process that modulates the frequency, rate or extent of process involved in the consumption of an object.</dcterms:description>
    <rdfs:label xml:lang="en">regulation of object consumption</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/process-number">
    <dc:identifier>SIO_000305</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/ordinal-position"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">process number</rdfs:label>
    <dcterms:description xml:lang="en">process number is a number associated with a process that denotes its ordinal position in a set of processes.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/chemical-synthesis-pathway">
    <rdfs:label xml:lang="en">chemical synthesis pathway</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A chemical synthesis pathway is a pathway involved in the assembly of a chemical.</dcterms:description>
    <dc:identifier>SIO_010527</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-reaction-pathway"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/PDB-record-identifier">
    <dcterms:description xml:lang="en">A PDB record identifier is an identifier for a PDB generated record.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">PDB record identifier</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/record-identifier"/>
    <dc:identifier>SIO_010032</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/clinical-trial">
    <dcterms:description xml:lang="en">A clinical trial is an intervention trial to determine the safety and efficacy of  medical interventions (e.g., drugs, diagnostics, devices, therapy protocols). </dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/intervention-study"/>
    <rdfs:subClassOf rdf:nodeID="Nf37b8c9359614954bc5107ec2541d726"/>
    <dc:identifier>SIO_001000</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">clinical trial</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb5563f65102243d6a4e27262822e4c65">
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-product"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/data-item"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/surface-normal">
    <dc:identifier>SIO_000533</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/vector-line"/>
    <rdfs:label xml:lang="en">surface normal</rdfs:label>
    <dcterms:description xml:lang="en">A surface normal is a vector that is perpendicular to a flat surface.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/technical-report">
    <dc:identifier>SIO_000164</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/publication"/>
    <rdfs:label xml:lang="en">technical report</rdfs:label>
    <dcterms:description xml:lang="en">A technical report is a publication published by a school or other institution, usually numbered within a series.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/speculation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001065</dc:identifier>
    <dcterms:description xml:lang="en">speculation is an opinion based on incomplete evidence.</dcterms:description>
    <rdfs:label xml:lang="en">speculation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/opinion"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/negative-nucleic-acid-strand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">negative nucleic acid strand</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/nucleic-acid-strand"/>
    <dcterms:alternative xml:lang="en">reverse strand</dcterms:alternative>
    <dcterms:description xml:lang="en">The negative nucleic acid strand is the strand that is that is complimentary to the forward strand and appears from 3' to 5'.</dcterms:description>
    <dc:identifier>SIO_001176</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/author-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/publishing-role"/>
    <rdfs:label xml:lang="en">author role</rdfs:label>
    <dc:identifier>SIO_000886</dc:identifier>
    <dcterms:description xml:lang="en">An author role is the role of an individual that creates a creative, written work.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-be-cleaved">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">to be cleaved</rdfs:label>
    <dc:identifier>SIO_010365</dc:identifier>
    <dcterms:description xml:lang="en">to be cleaved is the capability to be modified in a way that splits one part of the object from the other.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-be-modified"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/organism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organism</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-entity"/>
    <owl:equivalentClass rdf:nodeID="Nb9edbcc5d5734887985bf0a3d2770f67"/>
    <dcterms:description xml:lang="en">A biological organisn is a biological entity that consists of one or more cells and is capable of genomic replication (independently or not).</dcterms:description>
    <dc:identifier>SIO_010000</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/specimen">
    <dc:identifier>SIO_010412</dc:identifier>
    <rdfs:label xml:lang="en">specimen</rdfs:label>
    <dcterms:description xml:lang="en">A specimen is a portion of material for use in testing, examination, or study.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/sample"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/empty-set">
    <dc:identifier>SIO_000617</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nef20aa4765fe4ba2af520bc036436cbf"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/set"/>
    <dcterms:description xml:lang="en">An empty set is a set for which there are exactly 0 members.</dcterms:description>
    <rdfs:label xml:lang="en">empty set</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/gesturing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001059</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/communicating"/>
    <dcterms:description xml:lang="en">gesturing is a form of non-verbal communication in which visible bodily actions communicate particular messages, either in place of speech or together and in parallel with spoken words. Gestures include movement of the hands, face, or other parts of the body.</dcterms:description>
    <rdfs:label xml:lang="en">gesturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
