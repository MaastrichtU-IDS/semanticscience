  <rdf:Description rdf:about="http://semanticscience.org/resource/transfer-RNA-%28tRNA%29-gene">
    <dcterms:alternative xml:lang="en">tRNA gene</dcterms:alternative>
    <dcterms:alternative xml:lang="en">solube RNA (sRNA) gene</dcterms:alternative>
    <rdfs:subClassOf rdf:nodeID="N201dee3c519842f0818abefc94f0052a"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/non-protein-coding-RNA-%28ncRNA%29-gene"/>
    <dcterms:description xml:lang="en">A transfer RNA (tRNA) gene is a gene that codes for a tRNA used in the translation of a messenger RNA (mRNA) to produce a protein product.</dcterms:description>
    <dc:identifier>SIO_001230</dc:identifier>
    <rdfs:label xml:lang="en">transfer RNA (tRNA) gene</rdfs:label>
    <ns1:equivalentTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/SO_0001272</ns1:equivalentTo>
