    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/polygonal-face"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-part"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/professor-role">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/academic-role"/>
    <rdfs:subClassOf rdf:nodeID="N259465315e0b4594be688e6812c6583f"/>
    <rdfs:subClassOf rdf:nodeID="Nfeda837ddc864ba38b0287358fad64a4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000708</dc:identifier>
    <rdfs:label xml:lang="en">professor role</rdfs:label>
    <dcterms:description xml:lang="en">A professor role is the role of an individual that is involved in teaching of students (undergraduate and/or graduate) at a post-secondary academic institution.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N688d10cd99fd4932ad73001104cb0cbf">
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/polypeptide"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-product"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/maintenance-of-spatial-extent-of-process">
    <dcterms:description xml:lang="en">maintenance of spatial extent of process is a regulation of a process' spatial extent within some specified parameter.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process-spatial-extent"/>
    <rdfs:label xml:lang="en">maintenance of spatial extent of process</rdfs:label>
    <dc:identifier>SIO_001142</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/maintenance-of-duration-of-process">
    <dcterms:description xml:lang="en">maintenance of duration of process is a process that regulates a target process to maintain its duration within an expected interval.</dcterms:description>
    <dc:identifier>SIO_001143</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process-duration"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">maintenance of duration of process</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-mutual-disposition-of">
    <rdfs:label xml:lang="en">is mutual disposition of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-mutually-related-to"/>
    <dcterms:description xml:lang="en">a is mutual disposition of b if and only if the realization of the disposition  a necessarily causes the realization of the disposition b.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000697</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/left-value-axis">
    <dc:identifier>SIO_000459</dc:identifier>
    <dcterms:description xml:lang="en">A left value axis is a value axis that is spatially positioned to the left of the plot area.</dcterms:description>
    <rdfs:label xml:lang="en">left value axis</rdfs:label>
    <skos:example xml:lang="en">The value axis that ranges from 3.0 to 7.4 and corresponds to billions of dollars in Graph 1 of http://tinyurl.com/opwnvm</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/value-axis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/disgust">
    <dcterms:description xml:lang="en">Disgust is a feeling of revulsion or profound disapproval aroused by something unpleasant or offensive.</dcterms:description>
    <rdfs:label xml:lang="en">disgust</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/hostility"/>
    <dc:identifier>SIO_000828</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/submolecule">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/submolecular-entity"/>
    <rdfs:subClassOf rdf:nodeID="N5346983163024258a08d9d424d1e6d13"/>
    <rdfs:subClassOf rdf:nodeID="Naa931eb806eb4244a0d53de66c34a58f"/>
    <dc:identifier>SIO_010441</dc:identifier>
    <rdfs:label xml:lang="en">submolecule</rdfs:label>
    <dcterms:description xml:lang="en">A submolecule is any part of a molecule.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/molecular-complex">
    <dc:identifier>SIO_010506</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-complex"/>
    <rdfs:subClassOf rdf:nodeID="N78a1b95966794b85b75ffbaf3c5fd4d2"/>
    <dcterms:description xml:lang="en">A molecular complex is a chemical complex composed of at least one weakly interacting molecule.</dcterms:description>
    <rdfs:label xml:lang="en">molecular complex</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/validated-gene">
    <rdfs:subClassOf rdf:nodeID="N246603e7f358450392f088992afb8046"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene"/>
    <rdfs:label xml:lang="en">validated gene</rdfs:label>
    <dc:identifier>SIO_000991</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">An experimentally validated gene is a gene whose existence has been demonstrated through experimental methods.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/abstract-role">
    <rdfs:label xml:lang="en">abstract role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000678</dc:identifier>
    <dcterms:description xml:lang="en">An abstract role is a role whose basis lies in spatial/temporal or comparative relations. </dcterms:description>
