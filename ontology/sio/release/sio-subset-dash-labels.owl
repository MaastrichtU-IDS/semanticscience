  <rdf:Description rdf:about="http://semanticscience.org/resource/drug-drug-interaction">
    <dc:identifier>SIO_001006</dc:identifier>
    <dcterms:description xml:lang="en">A drug-drug interaction is an interaction in which two drugs interact in such a way to produce a non-additive biological response.</dcterms:description>
