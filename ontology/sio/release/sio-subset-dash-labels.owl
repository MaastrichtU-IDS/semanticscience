  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-match-to">
    <rdfs:range rdf:resource="http://semanticscience.org/resource/term"/>
    <ns1:equivalentTo>http://www.w3.org/2004/02/skos/core#relatedMatch</ns1:equivalentTo>
    <dc:identifier>SIO_000482</dc:identifier>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/term"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-similar-to"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">is match to</rdfs:label>
    <dcterms:description xml:lang="en">A is match to B iff A and B are terms with similar (related, broad, close, exact) meanings</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/ununhexium-atom">
    <rdfs:label xml:lang="en">ununhexium atom</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/atom"/>
    <dc:identifier>SIO_011087</dc:identifier>
