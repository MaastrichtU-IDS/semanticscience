  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/coding-frame-offset">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-quality"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a coding frame offset is a numeric value that indicates the number of bases from a reference start codon position.</dcterms:description>
    <rdfs:label xml:lang="en">coding frame offset</rdfs:label>
    <dc:identifier>SIO_001275</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-directly-after">
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-directly-before"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-positionally-after"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-directly-connected-to"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is directly after</rdfs:label>
    <dc:identifier>SIO_000241</dc:identifier>
    <dcterms:description xml:lang="en">is directly after is a relation between entities placed on a dimensional axis in which the projection of the position of the first entity is numerically greater than the projection of the position of the second entity, and the entities are adjacent to one another.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/inductive-argument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/argument"/>
    <dc:identifier>SIO_000264</dc:identifier>
    <rdfs:label xml:lang="en">inductive argument</rdfs:label>
    <dcterms:description xml:lang="en">An inductive argument is an argument that asserts that the truth of the conclusion is supported by the premises.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/work-phone-number">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/telephone-number"/>
    <rdfs:label xml:lang="en">work phone number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001324</dc:identifier>
    <dcterms:description>a work phone number is the number to connect to an phone at a place of work.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/algorithm">
    <dcterms:description xml:lang="en">An algorithm is an effective method expressed as a finite list of well-defined instructions for calculating a function.</dcterms:description>
    <rdfs:label xml:lang="en">algorithm</rdfs:label>
    <dc:identifier>SIO_000094</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/mathematical-entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/maintenance-of-frequency-of-process">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process-frequency"/>
    <rdfs:label xml:lang="en">maintenance of frequency of process</rdfs:label>
    <dcterms:description xml:lang="en">maintenance of frequency of process is a process that regulates the number of occurences of a target process type to a specified number or interval.</dcterms:description>
    <dc:identifier>SIO_001144</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/partial-positive-charge">
    <dc:identifier>SIO_000807</dc:identifier>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/partial-negative-charge"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/partial-charge"/>
    <rdfs:label xml:lang="en">partial positive charge</rdfs:label>
    <dcterms:description xml:lang="en">A partial negative charge is a negative charge where the value of the charge is negative.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/has-target">
    <dcterms:description xml:lang="en">has target is a relation between a process and an entity, where the entity is present at the beginning  of the process and undergoes a change or transformation in the process.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-input"/>
    <rdfs:label xml:lang="en">has target</rdfs:label>
    <dc:identifier>SIO_000291</dc:identifier>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-target-in"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
