  <rdf:Description rdf:about="http://semanticscience.org/resource/statement-of-consequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:description xml:lang="en">a statement of consequence is a statement concerning the result or effect of an action or condition.</dc:description>
