  <rdf:Description rdf:about="http://semanticscience.org/resource/single-bond">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010498</dc:identifier>
    <rdfs:label xml:lang="en">single bond</rdfs:label>
    <dcterms:description xml:lang="en">A single bond is a covalent bond between a pair of atoms in which one pair of electrons are shared.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/covalent-bond"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
