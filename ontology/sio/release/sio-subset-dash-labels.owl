    <rdfs:label xml:lang="en">full</rdfs:label>
    <dcterms:description xml:lang="en">full is the quality of contain an entity such that there is no more space for any additional entity.</dcterms:description>
    <dc:identifier>SIO_001340</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/containment-quality"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/hydrogen-atom">
