  <rdf:Description rdf:about="http://semanticscience.org/resource/hermaphrodite">
    <dc:identifier>SIO_000784</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hermaphrodite</rdfs:label>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/male"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/intersex"/>
    <dcterms:description xml:lang="en">hermaphrodite is a biological sex of an individual with both male and female sexual organs.</dcterms:description>
    <ns1:equivalentTo>PATO:0001827</ns1:equivalentTo>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/duplicate-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a duplicate role is a comparative role that holds when one item is an exact copy of another in a specific set.</dcterms:description>
    <rdfs:label xml:lang="en">duplicate role</rdfs:label>
    <dc:identifier>SIO_001416</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/comparative-role"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/hydrogen-bond">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/weak-submolecular-component"/>
    <rdfs:label xml:lang="en">hydrogen bond</rdfs:label>
    <dc:identifier>SIO_010033</dc:identifier>
    <dcterms:description xml:lang="en">A hydrogen bond is a weak submolecular interaction formed between a hydrogen atom and a electronegative atom.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/statute">
    <rdfs:label xml:lang="en">statute</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/legal-document"/>
    <dc:identifier>SIO_001371</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A statute is a formal written enactment of a legislative authority that governs a state, city or country.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-be-covalently-modified">
    <dcterms:description xml:lang="en">to be covalently modified is the capability of a chemical entity to have bonds added or removed</dcterms:description>
    <dc:identifier>SIO_010366</dc:identifier>
    <rdfs:label xml:lang="en">to be covalently modified</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-be-modified"/>
