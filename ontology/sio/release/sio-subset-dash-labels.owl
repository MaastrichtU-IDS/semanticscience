  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-ingest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001105</dc:identifier>
    <dcterms:description xml:lang="en">to ingest is the capability to take into the body by the mouth for digestion or absorption.</dcterms:description>
