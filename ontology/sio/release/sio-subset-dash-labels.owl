    <dc:identifier>SIO_000847</dc:identifier>
    <rdfs:label xml:lang="en">indifference</rdfs:label>
    <dcterms:description xml:lang="en">indifference is an emotion characterized by lack of interest, concern, or sympathy.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/bent">
