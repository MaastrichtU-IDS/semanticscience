    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A solid-state drive (SSD) is a data storage device that uses solid-state memory to store persistent data.</dcterms:description>
    <rdfs:label xml:lang="en">solid state hard drive</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
