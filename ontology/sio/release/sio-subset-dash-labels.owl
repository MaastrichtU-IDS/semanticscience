  <rdf:Description rdf:about="http://semanticscience.org/resource/excitement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">excitement</rdfs:label>
    <dcterms:description xml:lang="en">excitement is a positive emotion of feeling great enthusiasm and eagerness.</dcterms:description>
    <dc:identifier>SIO_000836</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/positive-emotion"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/pain">
    <rdfs:label xml:lang="en">pain</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/hurt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000951</dc:identifier>
    <dcterms:description xml:lang="en">Pain is an unpleasant sensory and emotional experience associated with actual or potential tissue damage, or described in terms of such damage.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/pre-mRNA">
    <rdfs:subClassOf rdf:nodeID="Nd872d3d13d9f4c5e9c993473eb78a38f"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/messenger-RNA"/>
    <rdfs:label xml:lang="en">pre-mRNA</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">Precursor mRNA (pre-mRNA) is a single strand of messenger ribonucleic acid (mRNA) that is synthesized from a DNA template throught transcription.</dcterms:description>
    <dc:identifier>SIO_010097</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/copyright-section">
    <rdfs:label xml:lang="en">copyright section</rdfs:label>
    <dcterms:description xml:lang="en">A copyright section is a document section that contains a notice of copyright.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/document-section"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000193</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-homologous-to">
    <rdfs:label xml:lang="en">is homologous to</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-variant-of"/>
    <dcterms:description xml:lang="en">a relation between two entities which indicates their common ancestry.</dcterms:description>
    <dc:identifier>SIO_010302</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
