  <rdf:Description rdf:about="http://semanticscience.org/resource/gene-promoter">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene-regulatory-component"/>
    <dc:identifier>SIO_010446</dc:identifier>
    <dcterms:description xml:lang="en">A gene promoter is a region of DNA that initiates transcription of a particular gene.</dcterms:description>
    <rdfs:label xml:lang="en">gene promoter</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/affects">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-output"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-affected-by"/>
    <rdfs:label xml:lang="en">affects</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_001158</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/information-content-entity">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/object"/>
    <rdfs:subClassOf rdf:nodeID="N636049b090d34833a3ca6d3b3f91b0c2"/>
    <dcterms:description xml:lang="en">information content entity is an object that requires some background knowledge or procedure to correctly interpret.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:subset>ice+</ns1:subset>
    <ns1:subset>core</ns1:subset>
    <rdfs:label xml:lang="en">information content entity</rdfs:label>
    <dc:identifier>SIO_000015</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-immediately-preceded-by">
    <dc:identifier>SIO_000251</dc:identifier>
    <dcterms:description xml:lang="en">A non-transitive temporal relation in which one process is immediately preceded by another process, such that there is no interval of time between the two processes.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-preceded-by"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is immediately preceded by</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/IP-number">
    <dcterms:description>an IP number is an number to connect to a device on the internet.</dcterms:description>
    <rdfs:label xml:lang="en">IP number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/informational-entity-identifier"/>
    <dcterms:alternative>IP address</dcterms:alternative>
    <dc:identifier>SIO_001322</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/has-participant">
    <ns1:equivalentTo>OBO_REL:has_participant</ns1:equivalentTo>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-spatiotemporally-related-to"/>
    <rdfs:label xml:lang="en">has participant</rdfs:label>
    <dcterms:description xml:lang="en">has participant is a relation that describes the participation of the object in the (processual) subject.</dcterms:description>
    <dc:identifier>SIO_000132</dc:identifier>
    <ns1:subset>core</ns1:subset>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/process"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/splice-site">
    <rdfs:label xml:lang="en">splice site</rdfs:label>
    <dc:identifier>SIO_010451</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/RNA-transcript-component"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A splice site is a region required for the excision of an intron and connection to another exon.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/cerium-atom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:exactMatch>CHEBI:33369</skos:exactMatch>
    <dc:identifier>SIO_011090</dc:identifier>
