    <rdfs:label xml:lang="en">differential gene expression ratio</rdfs:label>
    <dcterms:description xml:lang="en">A differential gene expression ratio is the ratio of gene expression values from a test sample compared to a control sample.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/personal-name">
    <dcterms:description xml:lang="en">A personal name is a name to identify an individual person and usually comprises of a first name and a last name.</dcterms:description>
