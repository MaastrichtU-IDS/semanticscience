    <dcterms:description xml:lang="en">intensity is a quality that represents the strength or degree of something.</dcterms:description>
    <rdfs:label xml:lang="en">intensity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001212</dc:identifier>
