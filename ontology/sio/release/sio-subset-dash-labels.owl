  <rdf:Description rdf:about="http://semanticscience.org/resource/regulation-of-process-frequency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001135</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-process"/>
    <dcterms:description xml:lang="en">regulation of a process duration is a process that modulates the frequency of another process relative to some reference process.</dcterms:description>
    <rdfs:label xml:lang="en">regulation of process frequency</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-about">
    <dcterms:description xml:lang="en">is about is a relation between an information content entity and the entity that its primary subject.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/describes"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-subject-of"/>
    <dc:identifier>SIO_000332</dc:identifier>
    <rdfs:label xml:lang="en">is about</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/gene-disease-association-linked-with-modifying-mutation">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene-disease-association-linked-with-genetic-variation"/>
    <dcterms:description xml:lang="en">A gene-disease association in which a gene mutation is known to modify the clinical presentation of the disease.</dcterms:description>
    <dc:identifier>SIO_001342</dc:identifier>
    <rdfs:label xml:lang="en">gene-disease association linked with modifying mutation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/collection-of-points">
    <dcterms:description xml:lang="en">A collection of points is a geometric entity that contains a non-zero set of geometric points. </dcterms:description>
    <rdfs:label xml:lang="en">collection of points</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nf0fc5fa2a26549cbbac457f93c6bd040"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/geometric-entity"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/collection"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000546</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/speed">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/rate-of-change"/>
    <rdfs:label xml:lang="en">speed</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">Speed is the rate of change of an object's position.</dcterms:description>
    <dc:identifier>SIO_001368</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/polar-solvent">
    <rdfs:label xml:lang="en">polar solvent</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N972e18235eef4dfbac0da67ad77280b2"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/solvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/nonpolar-solvent"/>
    <dcterms:description xml:lang="en">A polar solvent is a solvent that exhibits a polar quality.</dcterms:description>
    <dc:identifier>SIO_010459</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/sample">
    <dc:identifier>SIO_001050</dc:identifier>
    <dcterms:description xml:lang="en">A sample is a limited quantity of something (e.g. an individual or set of individuals from a population, or a portion of a substance) to be used for testing, analysis, inspection, investigation, demonstration, or trial use.</dcterms:description>
    <rdfs:subClassOf rdf:nodeID="N1ff4b272a5c444519d605247f98ba69a"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/heterogeneous-substance"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/toxic">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/toxicity"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/non-toxic"/>
    <dc:identifier>SIO_001009</dc:identifier>
    <rdfs:label xml:lang="en">toxic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">toxic is the quality of a substance imparing the normal functioning of a  system.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-translated-into">
    <rdfs:label xml:lang="en">is translated into</rdfs:label>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-translated-from"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/encodes"/>
    <skos:example xml:lang="en">RNA is translated into Protein</skos:example>
    <skos:example xml:lang="en">a relation between two information content entities in which one is translated into (a completely different kind of entity) another through some process.</skos:example>
    <dc:identifier>SIO_010082</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/category-axis">
    <owl:equivalentClass rdf:nodeID="Nb0c1563f10474daa9ee8229020ffd91e"/>
    <dc:identifier>SIO_000455</dc:identifier>
    <skos:example xml:lang="en">The horizontal axis corresponding to months of the year in graph 4 
of http://tinyurl.com/opwnvm</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/axis"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/value-axis"/>
    <dcterms:description xml:lang="en">A category axis is an axis in which the position along the line is partioned into categories.</dcterms:description>
    <rdfs:label xml:lang="en">category axis</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
