    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/exclusion-criterion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inclusion criterion</rdfs:label>
    <dcterms:description xml:lang="en">An inclusion criterion is a criterion that must be present to satisfy some objective.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
