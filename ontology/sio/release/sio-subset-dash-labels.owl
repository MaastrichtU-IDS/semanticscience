    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/object-quality"/>
    <rdfs:label xml:lang="en">fitness</rdfs:label>
    <dc:identifier>SIO_000357</dc:identifier>
    <dcterms:description xml:lang="en">fitness is the quality of an object with respect to some stated functions or evolutionary adaptation.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
