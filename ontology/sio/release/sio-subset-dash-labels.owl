    <dcterms:description xml:lang="en">A document title is a textual entity that summarizes the topic of the document in one sentence.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/title"/>
    <rdfs:label xml:lang="en">document title</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-property-of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-attribute-of"/>
    <dcterms:description xml:lang="en">is property of is a relation betweena  quality, capability or role and the entity that it and it alone bears.</dcterms:description>
    <dc:identifier>SIO_000224</dc:identifier>
    <rdfs:label xml:lang="en">is property of</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/start-point">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/terminal-point"/>
    <rdfs:label xml:lang="en">start point</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A start point is a terminal point which is the first of an ordered 
pair of points.</dcterms:description>
    <dc:identifier>SIO_000509</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/has-component-part">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-direct-part"/>
    <skos:example xml:lang="en">a human has blood as a component part</skos:example>
    <dc:identifier>SIO_000369</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:description xml:lang="en">has component part is a relation between a whole and a component part where the component is instrinsic to the whole, and loss of the part would change the kind that it is.</dcterms:description>
    <rdfs:label xml:lang="en">has component part</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/euphoria">
    <rdfs:label xml:lang="en">euphoria</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/happiness"/>
    <dc:identifier>SIO_000835</dc:identifier>
    <dcterms:description xml:lang="en">euphoria is an emotion characterized by intense feelings of well-being, elation, happiness, ecstasy, excitement, and joy.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5714a4c526de477eb40567d50d55017c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-proper-part"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/cell-%28informational%29"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N68cec2d0c387485e9e3a7e109311e037">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/row"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/is-unique-identifier-for"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-agent-in">
    <skos:example xml:lang="en">hexokinase is an agent in the conversion of glucose to glucose-6-phosphate</skos:example>
    <ns1:subset xml:lang="en">sadi</ns1:subset>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-participant-in"/>
    <rdfs:label xml:lang="en">is agent in</rdfs:label>
    <dc:identifier>SIO_000063</dc:identifier>
    <dcterms:description xml:lang="en">is agent in is a relation between an entity and a process, where the entity is present throughout the process, no permanent material change occurs, and is a causal participant in the process.</dcterms:description>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/has-agent"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/volume-number">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/count"/>
    <dc:identifier>SIO_000309</dc:identifier>
    <rdfs:label xml:lang="en">volume number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">volume number is a count of a sequence of periodicals.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/increasing-line">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/trend-line"/>
    <dc:identifier>SIO_000528</dc:identifier>
    <dcterms:description xml:lang="en">An increasing line is a line segment in which the startpoint and endpoint are ordered along one dimension and the difference of values in a second dimension is positive.</dcterms:description>
    <rdfs:label xml:lang="en">increasing line</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf452bc72325446f3a7a02411f126bd68">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/gene"/>
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/has-component-part"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nad915ff45b264db085623a656c209163">
    <owl:intersectionOf rdf:nodeID="Nf6d3cd185a0d4657acb415366a198f07"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/node">
