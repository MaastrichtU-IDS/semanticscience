  <rdf:Description rdf:about="http://semanticscience.org/resource/biological-reproduction">
    <dc:identifier>SIO_000587</dc:identifier>
    <dcterms:description xml:lang="en">biological reproduction is the biological process by which one or more biological organisms are produced from their "parents". </dcterms:description>
