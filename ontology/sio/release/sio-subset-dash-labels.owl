  <rdf:Description rdf:about="http://semanticscience.org/resource/primary-active-transport">
    <rdfs:label xml:lang="en">primary active transport</rdfs:label>
    <dc:identifier>SIO_000577</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/active-transport"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/secondary-active-transport"/>
    <dcterms:description xml:lang="en">primary active transport, also called direct active transport, directly uses energy to transport molecules across a membrane.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/increased-object-production-from-increased-regulation">
    <rdfs:label xml:lang="en">increased object production from increased regulation</rdfs:label>
    <dc:identifier>SIO_001146</dc:identifier>
    <dcterms:description xml:lang="en">increased regulation leads to an increase in the number of target objects of a specified type.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/regulation-of-object-production"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/has-expression">
    <dc:identifier>SIO_000420</dc:identifier>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-expression-of"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-generically-related-with"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:example xml:lang="en">the story 'war of worlds' is expressed as every language edition of the book 'war of the worlds'</skos:example>
    <rdfs:label xml:lang="en">has expression</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/intervention-study">
    <dc:identifier>SIO_001048</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/experiment"/>
    <rdfs:label xml:lang="en">intervention study</rdfs:label>
    <dcterms:description xml:lang="en">An intervention study has the objective of improving the condition of an individual or a group of individuals, and demonstrates the magnitude of that capability by comparing it to a control group.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/boxplot">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/line-bar-graph"/>
    <dcterms:description xml:lang="en">A boxplot (box-and-whisker diagram) is a convenient way of graphically depicting groups of numerical data through their five-number summaries: the smallest observation (sample minimum), lower quartile (Q1), median (Q2), upper quartile (Q3), and largest observation (sample maximum).</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">boxplot</rdfs:label>
    <dc:identifier>SIO_000909</dc:identifier>
