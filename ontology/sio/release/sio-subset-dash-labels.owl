  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/polar-coordinate-system">
    <dc:identifier>SIO_000327</dc:identifier>
    <rdfs:label xml:lang="en">polar coordinate system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/coordinate-system"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A polar coordinate system is a two-dimensional coordinate system in which each point on a plane is determined by a distance from a fixed point and an angle from a fixed direction.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/1D-cartesian-point">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/point"/>
    <dc:identifier>SIO_000441</dc:identifier>
    <rdfs:label xml:lang="en">1D cartesian point</rdfs:label>
    <owl:equivalentClass rdf:nodeID="N7d779d547f7747e79b344ce4f48d67bb"/>
    <dcterms:description xml:lang="en">A 1D cartesian point is a point whose position is specified along a single dimension using Cartesian coordinates.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-reduce-the-activation-energy">
    <dc:identifier>SIO_000549</dc:identifier>
    <rdfs:label xml:lang="en">to reduce the activation energy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-change-the-activation-energy"/>
    <dcterms:alternative>to activate</dcterms:alternative>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/to-increase-the-activation-energy"/>
    <dcterms:description xml:lang="en">to reduce the activation energy is to require a smaller amount of energy in order to form or break a chemical bond.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-lose-a-covalent-bond">
    <dc:identifier>SIO_001104</dc:identifier>
    <rdfs:label xml:lang="en">to lose a covalent bond</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-be-covalently-modified"/>
