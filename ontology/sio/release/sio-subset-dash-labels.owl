    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/sentence"/>
    <rdfs:label xml:lang="en">question</rdfs:label>
    <dc:identifier>SIO_000085</dc:identifier>
    <dcterms:description xml:lang="en">A question is a linguistic expression used to make a request for information.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
