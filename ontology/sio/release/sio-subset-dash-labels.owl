  <rdf:Description rdf:about="http://semanticscience.org/resource/y-axis">
    <dcterms:description xml:lang="en">A y-axis is a Cartesian coordinate axis that is spatially oriented perpendicular to the x-axis.</dcterms:description>
    <dcterms:alternative>vertical axis</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">y-axis</rdfs:label>
    <dc:identifier>SIO_000453</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/Cartesian-coordinate-axis"/>
