    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/mean">
    <dcterms:alternative>average</dcterms:alternative>
    <dcterms:alternative>arithmeritic mean</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001109</dc:identifier>
    <rdfs:label xml:lang="en">mean</rdfs:label>
    <dcterms:description xml:lang="en">A mean is the central tendency of a collection of numbers taken as the sum of the numbers divided by the size of the collection.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/centrality-measure"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/student-advisor-role">
    <dc:identifier>SIO_000876</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/academic-role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A student advisor role is the role of an individual employed at an academic organization that is involved in advising students.</dcterms:description>
    <rdfs:label xml:lang="en">student advisor role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/valid-argument">
    <rdfs:label xml:lang="en">valid argument</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000266</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/argument"/>
    <rdfs:subClassOf rdf:nodeID="Nd8e75df0f6434273826fedc177cde56e"/>
    <dcterms:description xml:lang="en">A valid argument is an argument where the truth of the conclusion is a logical consequence of the premises and (consequently) its corresponding conditional is a necessary truth.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/peer-reviewed">
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/editor-reviewed"/>
    <rdfs:label xml:lang="en">peer-reviewed</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/reviewed"/>
    <dc:identifier>SIO_001035</dc:identifier>
    <dcterms:description xml:lang="en">peer-reviewed is the quality of a textual entity that has been examined and commented by a peer expert reviewer.</dcterms:description>
