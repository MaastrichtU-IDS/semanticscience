  <rdf:Description rdf:about="http://semanticscience.org/resource/is-product-of">
    <rdfs:label xml:lang="en">is product of</rdfs:label>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/has-product"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-output-of"/>
    <skos:example xml:lang="en">glucose-6-phosphate is the product of the hexokinase-mediated conversion of glucose to glucose-6-phosphate.</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000311</dc:identifier>
    <ns1:subset xml:lang="en">sadi</ns1:subset>
    <dcterms:description xml:lang="en">is product of is a relation between an entity and a process, where the entity is present at the end  of the process as a result of a transformation in the process target.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
