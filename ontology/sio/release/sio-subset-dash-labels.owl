  <rdf:Description rdf:about="http://semanticscience.org/resource/to-ionize">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-modify-electronically"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">to ionize is the capability to physically convert an atom or molecule into an ion by adding or removing charged particles such as electrons or other ions.</dcterms:description>
    <rdfs:label xml:lang="en">to ionize</rdfs:label>
    <dc:identifier>SIO_000350</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/precedes">
    <rdfs:label xml:lang="en">precedes</rdfs:label>
    <dc:identifier>SIO_000248</dc:identifier>
    <ns1:subset>core</ns1:subset>
    <dcterms:description xml:lang="en">A transitive, temporal relation in which one process precedes (has occured earlier than) another process.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-causally-related-from"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-preceded-by"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/concept">
    <dc:identifier>SIO_000326</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/term"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A concept is term that refers to a generalization of a set of attributes or entities.</dcterms:description>
    <rdfs:label xml:lang="en">concept</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/charge-quality">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-quality"/>
    <dc:identifier>SIO_010442</dc:identifier>
    <owl:equivalentClass rdf:nodeID="Ne837d2db3653482a942d64abd6863bcf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">charge quality</rdfs:label>
    <dcterms:description xml:lang="en">charge quality is the quality pertaining to electric charge.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
