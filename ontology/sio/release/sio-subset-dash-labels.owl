    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/right-open-interval">
    <dc:identifier>SIO_001252</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/interval"/>
    <dcterms:description xml:lang="en">a right open interval is an interval in which there is no element that is greater than all other elements.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">right open interval</rdfs:label>
