  <rdf:Description rdf:about="http://semanticscience.org/resource/decreased-spatial-extent-of-process-from-decreased-regulation">
    <dcterms:description xml:lang="en">The increase of regulation leads to a decreased spatial extent of the target process.</dcterms:description>
    <dc:identifier>SIO_001141</dc:identifier>
