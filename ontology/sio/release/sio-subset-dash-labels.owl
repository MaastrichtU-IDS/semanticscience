    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/life-status"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/dead"/>
    <dcterms:description xml:lang="en">alive is the state of a biological organism that exhibits biological functions.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010058</dc:identifier>
