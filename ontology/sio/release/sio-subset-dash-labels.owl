    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/disagreement">
    <dcterms:description xml:lang="en">agreement is the result of consensus decision making when members of the group do not all agree.</dcterms:description>
    <dc:identifier>SIO_000967</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">disagreement</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/agreement-quality"/>
