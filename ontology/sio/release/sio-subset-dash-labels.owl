    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/publication"/>
    <dc:identifier>SIO_000159</dc:identifier>
    <dcterms:description xml:lang="en">An edited publication is a publication that has been examined and potentially changed by an editor.</dcterms:description>
    <rdfs:label xml:lang="en">edited publication</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
