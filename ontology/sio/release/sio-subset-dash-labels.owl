  <rdf:Description rdf:about="http://semanticscience.org/resource/exclusive-disjunction-%28xor%29">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/disjunction-%28or%29"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">exclusive disjunction (xor)</rdfs:label>
    <dcterms:description xml:lang="en">XOR, also called exclusive disjunction or (symbolized XOR, EOR, EXOR, or ⊕), is a type of logical disjunction on two operands that results in a value of true if exactly one of the operands has a value of true.</dcterms:description>
    <dc:identifier>SIO_000282</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
