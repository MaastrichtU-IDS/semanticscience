  <rdf:Description rdf:about="http://semanticscience.org/resource/carbohydrate-residue">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organic-submolecule"/>
    <rdfs:subClassOf rdf:nodeID="N662412dd65cd4d46be2019a0efaac86d"/>
    <rdfs:subClassOf rdf:nodeID="Ndb9ccc13f7684835ac7539b188327fb9"/>
    <dcterms:description xml:lang="en">A carbohydrate residue is a part of a molecule that was derived from a monosaccharide molecule.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010334</dc:identifier>
    <rdfs:label xml:lang="en">carbohydrate residue</rdfs:label>
