  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/normal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A quality that has a value that is normal or average.</dcterms:description>
    <rdfs:label xml:lang="en">normal</rdfs:label>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/abnormal"/>
    <dc:identifier>SIO_000554</dc:identifier>
    <ns1:equivalentTo>PATO:0000461</ns1:equivalentTo>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/normality"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/heterogeneous">
    <dcterms:description xml:lang="en">homogeneous is a quality that describes the varied composition of an object.</dcterms:description>
    <rdfs:label xml:lang="en">heterogeneous</rdfs:label>
    <dc:identifier>SIO_001091</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/compositional-quality"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/co-enzyme-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/cofactor-role"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/substrate-role"/>
    <rdfs:label xml:lang="en">co-enzyme role</rdfs:label>
    <dc:identifier>SIO_000800</dc:identifier>
    <dcterms:description xml:lang="en">A co-factor role in which the chemical entity is modified during catalysis and must be regenerated.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/histogram">
    <rdfs:label xml:lang="en">histogram</rdfs:label>
    <dc:identifier>SIO_000911</dc:identifier>
    <dcterms:description xml:lang="en">A histogram is a graphical representation of data which consists of tabular frequencies, shown as adjacent rectangles, over discrete intervals (bins) , with an area equal to the frequency of the observations in the interval.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chart"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/post-translational-modification">
    <rdfs:label xml:lang="en">post-translational modification</rdfs:label>
    <dc:identifier>SIO_001393</dc:identifier>
    <dc:description xml:lang="en">a post-translational modification is a part of a protein that was added, removed, or modified as a result of a chemical reaction after synthesis.</dc:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/amino-acid-polymer-submolecule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
