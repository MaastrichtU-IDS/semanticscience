  <rdf:Description rdf:about="http://semanticscience.org/resource/pharmacokinetic-pathway">
    <rdfs:label xml:lang="en">pharmacokinetic pathway</rdfs:label>
    <dc:identifier>SIO_001255</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/metabolic-pathway"/>
    <dcterms:description xml:lang="en">a pharmacokinetic pathway is a metabolic pathway which describes the metabolism of a drug molecule.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/mereological-chart">
    <dcterms:description xml:lang="en">A mereological chart is a chart that illustrates the parts in the context of the whole.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chart"/>
    <dc:identifier>SIO_000940</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mereological chart</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/pie-chart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pie chart</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/mereological-chart"/>
    <dcterms:description xml:lang="en">A pie chart is a circular chart divided into sectors each of whose length  is proportional to the quantity it represents.</dcterms:description>
    <dc:identifier>SIO_000929</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-frequency-of">
    <dc:identifier>SIO_000901</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-measurement-value-of"/>
    <rdfs:label xml:lang="en">is frequency of</rdfs:label>
    <dcterms:description xml:lang="en">is frequency of is a relation between a temporal unit and an object or event</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/creating">
    <dcterms:alternative>creation</dcterms:alternative>
    <dcterms:alternative>formulation</dcterms:alternative>
    <dcterms:alternative>synthesis</dcterms:alternative>
    <dcterms:alternative>production</dcterms:alternative>
    <dcterms:alternative>development</dcterms:alternative>
    <dc:identifier>SIO_000588</dc:identifier>
