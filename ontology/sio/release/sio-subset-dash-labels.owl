    <rdfs:label xml:lang="en">reasoning</rdfs:label>
    <dcterms:description xml:lang="en">reasoning is the agentive process of using knowledge to evaluate the truth value of a proposition.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
