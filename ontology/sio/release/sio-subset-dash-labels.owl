  <rdf:Description rdf:about="http://semanticscience.org/resource/stationary-point">
    <dc:identifier>SIO_000741</dc:identifier>
    <dcterms:description xml:lang="en">A stationary point is a point that is part of a curve in which the derivative at that point is zero, and hence its value is at least a local maximum or minimum.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/data-point"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stationary point</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/procedure">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/process"/>
    <rdfs:subClassOf rdf:nodeID="N5901fb6e09134bfab66a09c2dbd2b6bd"/>
    <rdfs:subClassOf rdf:nodeID="N662c8bb6dd9a477fb030cbe154591344"/>
    <rdfs:label xml:lang="en">procedure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000999</dc:identifier>
    <dcterms:description xml:lang="en">A procedure is a process that attempts to achieve one or more objectives by following an established set of actions.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/hemizygous">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001266</dc:identifier>
    <rdfs:label xml:lang="en">hemizygous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/zygosity"/>
    <dcterms:description>hemizygous is the quality of a biological organism in which, based on the ploidy of the organism, there is half the number of alleles than normal at a given locus.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/gadolinium-atom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/atom"/>
    <skos:exactMatch>CHEBI:33375</skos:exactMatch>
    <dc:identifier>SIO_011096</dc:identifier>
    <rdfs:label xml:lang="en">gadolinium atom</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/longitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">longitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/geographic-position"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/latitude"/>
    <dc:identifier>SIO_000318</dc:identifier>
    <dcterms:description xml:lang="en">Longitude is a geographic position that refers to  the angle east or west of a reference meridian between the two geographical poles to another meridian that passes through an arbitrary point.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/rectangle">
    <dc:identifier>SIO_000518</dc:identifier>
    <rdfs:label xml:lang="en">rectangle</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/quadrilateral"/>
    <dcterms:description xml:lang="en">A rectangle is a quadrilateral in which one pair of line segments are  parallel and the other pair are perpendicular to the first pair.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
