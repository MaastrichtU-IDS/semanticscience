  <rdf:Description rdf:about="http://semanticscience.org/resource/translation">
    <rdfs:label xml:lang="en">translation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biosynthesis"/>
    <rdfs:subClassOf rdf:nodeID="N688d10cd99fd4932ad73001104cb0cbf"/>
    <rdfs:subClassOf rdf:nodeID="N790871ce518d4d9bbbdc09a8df4a5e04"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010301</dc:identifier>
    <dcterms:description xml:lang="en">translation is the process of producing a polypeptide from a ribonucleic acid by a ribosome.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/full">
