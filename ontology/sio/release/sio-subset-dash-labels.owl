    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/movement"/>
    <dcterms:description xml:lang="en">active movement is the process in which an object is spatially displaced using some chemical energy.</dcterms:description>
    <rdfs:label xml:lang="en">active movement</rdfs:label>
    <dc:identifier>SIO_000574</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/aromatic-bond">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/covalent-bond"/>
    <rdfs:label xml:lang="en">aromatic bond</rdfs:label>
    <dcterms:description xml:lang="en">An aromatic bond is an interaction between a set of atoms across which pairs of electrons are shared.</dcterms:description>
    <dc:identifier>SIO_010501</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/biological-sex">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-quality"/>
    <dc:identifier>SIO_010029</dc:identifier>
    <rdfs:label xml:lang="en">biological sex</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">biological sex is the quality of a biological organism based on reproductive function or organs.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/data-collection">
