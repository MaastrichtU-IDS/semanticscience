    <dc:identifier>SIO_010283</dc:identifier>
    <ns1:equivalentTo>biopax:Transport</ns1:equivalentTo>
    <rdfs:label xml:lang="en">chemical transport</rdfs:label>
    <dcterms:description xml:lang="en">chemical transport is the directed movement of a chemical entity by some agent (e.g. transporter).</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/academic">
