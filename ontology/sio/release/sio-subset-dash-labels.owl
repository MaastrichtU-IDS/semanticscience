  <rdf:Description rdf:about="http://semanticscience.org/resource/gene">
    <ns1:equivalentTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/SO_0000704</ns1:equivalentTo>
    <ns1:equivalentTo>biopax:Gene</ns1:equivalentTo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene</rdfs:label>
    <dcterms:description xml:lang="en">A gene is part of a nucleic acid that contains all the necessary elements to encode a functional transcript.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/nucleic-acid-part"/>
    <dc:identifier>SIO_010035</dc:identifier>
