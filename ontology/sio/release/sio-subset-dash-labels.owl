  <rdf:Description rdf:about="http://semanticscience.org/resource/chemical-transport">
    <rdfs:subClassOf rdf:nodeID="Ne54ee7b91aec45cd96552d3df03967bc"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/transporting"/>
