  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/most-of-the-time">
    <dcterms:alternative>most of the time</dcterms:alternative>
    <dc:identifier>SIO_001291</dc:identifier>
    <rdfs:label xml:lang="en">most of the time</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/temporal-qualifier"/>
    <dcterms:description>most refers to in the majority of occasions</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-observe">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-passively-interact-with"/>
    <rdfs:label xml:lang="en">to observe</rdfs:label>
    <dcterms:description xml:lang="en">to observe is the capability to watch attentively.</dcterms:description>
    <dc:identifier>SIO_000353</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/multicellular-organism">
    <dcterms:description xml:lang="en">A multi-cellular organism is an organism that consists of more than one cell.</dcterms:description>
    <rdfs:subClassOf rdf:nodeID="N77d15ddd4fe245d79440996e99633311"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/cellular-organism"/>
    <dc:identifier>SIO_010375</dc:identifier>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/unicellular-organism"/>
    <rdfs:label xml:lang="en">multicellular organism</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0e9baefcb82d405bb4459bacff1004aa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Nc74bdc8cba2944128803a02b673c6914"/>
  </rdf:Description>
