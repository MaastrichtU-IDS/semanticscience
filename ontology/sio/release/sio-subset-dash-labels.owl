  <rdf:Description rdf:about="http://semanticscience.org/resource/proposition">
    <dcterms:description xml:lang="en">A proposition is a sentence expressing something true or false.</dcterms:description>
    <rdfs:subClassOf rdf:nodeID="Nc7ff5778a8da484b82f7af97076255fb"/>
    <rdfs:subClassOf rdf:nodeID="Nab4b69777e91485b86bf37c41b4ee7a9"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/description"/>
