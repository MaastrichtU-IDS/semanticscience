  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/realizable-entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:subset>core</ns1:subset>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/attribute"/>
    <rdfs:subClassOf rdf:nodeID="Na6d3433b7eb54ee2a925f45b8778b67d"/>
    <rdfs:subClassOf rdf:nodeID="N3da2e7a26bd14afb88ee1650b21ae6fb"/>
    <dc:identifier>SIO_000340</dc:identifier>
    <rdfs:label xml:lang="en">realizable entity</rdfs:label>
    <dcterms:description xml:lang="en">A realizable entity is an attribute that is exhibited under some condition and is realized in some process.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-refuted-by">
    <dc:identifier>SIO_000774</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/has-evidence"/>
    <rdfs:label xml:lang="en">is refuted by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-refuting-evidence-for"/>
    <dcterms:description xml:lang="en">has evidence is a relation between a proposition and something that refutes (is incompatible with) the truth of the assertion.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
