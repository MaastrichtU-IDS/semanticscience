  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/structural-motif">
    <dcterms:description xml:lang="en">A structural motif is a pattern in a structure formed by a spatial arrangement of objects (e.g. atoms).</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">structural motif</rdfs:label>
