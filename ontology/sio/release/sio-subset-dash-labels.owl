  <rdf:Description rdf:about="http://semanticscience.org/resource/immediately-derives-into">
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-immediately-derived-from"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000246</dc:identifier>
    <dcterms:description xml:lang="en">a immediately derives into b if and only if a or some significant part thereof is consumed in the formation of b and there are no identifiable intermediate entities between a and b.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/derives-into"/>
    <rdfs:label xml:lang="en">immediately derives into</rdfs:label>
