  <rdf:Description rdf:about="http://semanticscience.org/resource/nucleotide-residue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/nucleic-acid-part"/>
    <dcterms:description xml:lang="en">A nucleotide residue is a part of a molecule that derives from a nucleotide.</dcterms:description>
    <rdfs:label xml:lang="en">nucleotide residue</rdfs:label>
    <dc:identifier>SIO_010075</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/electronic-structure">
    <dcterms:description xml:lang="en">electronic structure is the electron configuration is the distribution of electrons of an atom or molecule (or other physical structure) in atomic or molecular orbitals.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-structure"/>
    <dcterms:alternative>electronic configuration</dcterms:alternative>
    <rdfs:label xml:lang="en">electronic structure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">the electron configuration of the neon atom is 1s2 2s2 2p6.</skos:example>
    <dc:identifier>SIO_001099</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/host">
    <dc:identifier>SIO_010415</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A host is an organism that harbors a parasite, or a mutual or commensal symbiont, typically providing nourishment and shelter.</dcterms:description>
    <rdfs:label xml:lang="en">host</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organism"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/temporal-qualifier">
    <dcterms:description>a temporal qualifier is pertains to the frequency of the event of interest.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/informational-quality"/>
    <rdfs:label xml:lang="en">temporal qualifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001288</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/right-handed-helical">
    <rdfs:label xml:lang="en">right-handed helical</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/helicity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001274</dc:identifier>
    <dcterms:description xml:lang="en">right-handed helical quality is the quality in which a clockwise screwing motion moves the helix away from the observed along the line of sight along the helix's axis.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/formal-specification">
    <dcterms:description xml:lang="en">A formal specification is a mathematical description of software or hardware that may be used to develop an implementation.</dcterms:description>
    <dc:identifier>SIO_000621</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/functional-specification"/>
    <rdfs:label xml:lang="en">formal specification</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N031e73350b6b41f2bfab782b83288609">
