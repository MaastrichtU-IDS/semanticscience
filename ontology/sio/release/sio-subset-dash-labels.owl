    <dc:identifier>SIO_000815</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/apprehension"/>
    <dcterms:description xml:lang="en">anxiety is an emotion charactersized by intense feeling of fear and concern coupled with a physical response.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">anxiety</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
