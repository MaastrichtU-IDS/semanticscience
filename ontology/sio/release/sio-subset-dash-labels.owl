  <rdf:Description rdf:about="http://semanticscience.org/resource/social-relation">
    <dc:identifier>SIO_000287</dc:identifier>
    <dcterms:description xml:lang="en">A social relation is a social entity that describes a relationship  between two or more individuals or groups.</dcterms:description>
