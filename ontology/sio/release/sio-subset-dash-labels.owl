  <rdf:Description rdf:about="http://semanticscience.org/resource/gene-disease-association-linked-with-somatic-modifying-mutation">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/gene-disease-association-linked-with-modifying-mutation"/>
    <dcterms:description xml:lang="en">A gene-variant disease association in which a somatic mutation in the gene modifies the clinical presentation of the disease, and it may not be passed on to offspring.</dcterms:description>
