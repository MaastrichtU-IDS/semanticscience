  <rdf:Description rdf:about="http://semanticscience.org/resource/intersex">
    <dc:identifier>SIO_001405</dc:identifier>
    <rdfs:label xml:lang="en">intersex</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/biological-sex"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/female"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">intersex is a biological sex characterised by birth with genitalia and/or secondary sexual characteristics of indeterminate sex, or which combine features of both sexes.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/severe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">severe</rdfs:label>
    <dcterms:description xml:lang="en">severe is a qualitative intensity value that is more intense than strong, but less intense than fatal.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/intensity"/>
    <dc:identifier>SIO_001215</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
