    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">to separate</rdfs:label>
    <dcterms:description xml:lang="en">to separate is the capability to i) distinguish some entities based on some attribute(s) and ii) subsequently physically displace them.</dcterms:description>
    <dc:identifier>SIO_000349</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/sequence-start-position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/sequence-element-position"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/start-position"/>
    <dcterms:description xml:lang="en">A sequence start position is the start position for a sequence of characters.</dcterms:description>
    <dc:identifier>SIO_000791</dc:identifier>
    <rdfs:label xml:lang="en">sequence start position</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
