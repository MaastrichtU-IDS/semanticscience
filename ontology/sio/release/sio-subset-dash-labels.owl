    <owl:equivalentClass rdf:nodeID="N2b9768fed569451b8caa2b9c69bfcc93"/>
    <dcterms:description xml:lang="en">An isomer is a molecule that is compositionally identical to another molecule as a result of a different atomic connectivity.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/molecule"/>
    <rdfs:subClassOf rdf:nodeID="Nbb66d226d2b24f12bbd9e76b5d4b5230"/>
    <rdfs:label xml:lang="en">isomer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/acknowledgements-section">
