  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/indifference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/emotion"/>
