  <rdf:Description rdf:about="http://semanticscience.org/resource/double-displacement-reaction">
    <dc:identifier>SIO_010513</dc:identifier>
    <rdfs:label xml:lang="en">double displacement reaction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/displacement-reaction"/>
    <dcterms:description xml:lang="en">A double displacement reaction is a displacement reaction in which two molecules swap ions, effectively displacing each other to form two new molecules.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/amino-acid-polymer">
    <rdfs:subClassOf rdf:nodeID="Ne0f052260f7648de8bc728abc75a89d3"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organic-polymer"/>
    <dcterms:description xml:lang="en">an amino acid polymer is an organic polymer composed of two or more amino acid residues.</dcterms:description>
    <rdfs:label xml:lang="en">amino acid polymer</rdfs:label>
    <dc:identifier>SIO_001427</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/alpha-helix">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/amino-acid-polymer-submolecule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_010468</dc:identifier>
    <dcterms:description xml:lang="en">An alpha helix is structural region of a protein that is characterized by 3.6 residues per turn,  a translation of 1.5 angstroms along the helical axis in which backbone N-H groups form a hydrogen bond to the backbone carboxyl group of the amino acid four residues prior.</dcterms:description>
    <rdfs:label xml:lang="en">alpha helix</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
