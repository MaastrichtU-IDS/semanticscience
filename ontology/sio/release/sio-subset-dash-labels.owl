  <rdf:Description rdf:about="http://semanticscience.org/resource/medical-diagnosis">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/medical-procedure"/>
    <rdfs:subClassOf rdf:nodeID="N98ba35c6cb904b909747f92a8201c59d"/>
    <rdfs:subClassOf rdf:nodeID="N3477ede475cc412389efa5fa327f4716"/>
    <dcterms:description xml:lang="en">A medical diagnosis (often simply termed diagnosis) refers to the process of attempting to determine or identify a possible disease or disorder.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001001</dc:identifier>
    <rdfs:label xml:lang="en">medical diagnosis</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-directly-before">
    <rdfs:label xml:lang="en">is directly before</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-positionally-before"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-directly-connected-to"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <dcterms:description xml:lang="en">is directly before is a relation between entities placed on a dimensional axis in which the projection of the position of the first entity is numerically less than the projection of the position of the second entity, and the entities are adjacent to one another.</dcterms:description>
    <dc:identifier>SIO_000242</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9be25c92c1d84afb809b073c9e03ed47">
    <owl:onProperty rdf:resource="http://semanticscience.org/resource/is-transcribed-into"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/RNA-transcript"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/polar">
    <dc:identifier>SIO_001046</dc:identifier>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/non-polar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/polar-quality"/>
    <rdfs:label xml:lang="en">polar</rdfs:label>
    <dcterms:description xml:lang="en">polar is the quality of having a dipole.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/directed-acyclic-graph">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a directed acyclic graph or DAG is a network digram that contains directed edges in which nodes may have multiple parents, but there are no cycles.</dcterms:description>
    <dcterms:alternative xml:lang="en">dag</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/network-diagram"/>
    <dc:identifier>SIO_001332</dc:identifier>
    <rdfs:label xml:lang="en">directed acyclic graph</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
