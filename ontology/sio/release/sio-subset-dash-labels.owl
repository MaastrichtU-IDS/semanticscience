  <rdf:Description rdf:about="http://semanticscience.org/resource/is-base-for">
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-attribute-of"/>
    <dcterms:description xml:lang="en">is base for is a relation between a quality and the realizable entity that it is the basis for.</dcterms:description>
    <rdfs:range rdf:resource="http://semanticscience.org/resource/realizable-entity"/>
    <rdfs:label xml:lang="en">is base for</rdfs:label>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/quality"/>
    <skos:example xml:lang="en">the solubility of salt (the disposition) is based on the molecular structure of NaCl (the quality) that allows the polarized water-molecules (the trigger)  to break the ion bonds (the realization).</skos:example>
    <dc:identifier>SIO_000642</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N075d10cd8fc94ea78bc870ea3a660cff">
