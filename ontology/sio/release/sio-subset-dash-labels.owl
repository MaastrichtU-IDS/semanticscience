    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001361</dc:identifier>
    <dcterms:description>to store is the capability to place an object into a medium in which it can be retrieved in the future.</dcterms:description>
    <rdfs:label xml:lang="en">to store</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
