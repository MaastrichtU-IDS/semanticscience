  <rdf:Description rdf:about="http://semanticscience.org/resource/century">
    <dcterms:description xml:lang="en">A century is a period of one hundred years.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/time-interval"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
