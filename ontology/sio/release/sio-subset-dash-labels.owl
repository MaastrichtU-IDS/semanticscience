  <rdf:Description rdf:about="http://semanticscience.org/resource/t-statistic-based-increased-differential-gene-expression">
    <rdfs:subClassOf rdf:nodeID="N255bfe8fa75941a4985ae406388fb35e"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/differential-gene-expression-ratio"/>
    <dcterms:description xml:lang="en">A t-statistic based increased differential gene expression is a differential gene expression ratio in which the t-statistic is greater than zero.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">t-statistic based increased differential gene expression</rdfs:label>
