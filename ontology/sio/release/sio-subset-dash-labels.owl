  <rdf:Description rdf:about="http://semanticscience.org/resource/start-date">
    <dc:identifier>SIO_000031</dc:identifier>
    <dcterms:description xml:lang="en">A start date is a time instant pertaining to the date of the beginning of a process.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/time-instant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
