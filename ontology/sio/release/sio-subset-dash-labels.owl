  <rdf:Description rdf:about="http://semanticscience.org/resource/local-minimum-stationary-point">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/stationary-point"/>
    <dcterms:description xml:lang="en">A local minimum stationary point is a point that has a lower value in  some axis than adjacent points.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000743</dc:identifier>
    <rdfs:label xml:lang="en">local minimum stationary point</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/axis">
    <rdfs:comment>The value of a plotted geometric objects (e.g. point) can be obtained from the perpendicular projection of the position of the object onto the axis. Axis may also be associated with a textual description of what the values on the axis represents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/directed-line-segment"/>
    <rdfs:subClassOf rdf:nodeID="Nefe010fbeb964f8cb5ddc75f447fbc73"/>
    <skos:example xml:lang="en">The left vertical and bottom horizontal lines with tickmarks in 
Graph 1 http://tinyurl.com/opwnvm</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000450</dc:identifier>
    <rdfs:label xml:lang="en">axis</rdfs:label>
    <dcterms:description xml:lang="en">An axis is a line segment that is part of a statistical graph in which the 
position along the line corresponds to a numeric or categorical value.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/weak-submolecular-component">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/submolecular-entity"/>
    <dc:identifier>SIO_010005</dc:identifier>
    <dcterms:description xml:lang="en">A weak submolecular component is a submolecular component that weakly connects submolecular components.</dcterms:description>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/strong-submolecular-component"/>
    <rdfs:label xml:lang="en">weak submolecular component</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/brief">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/legal-document"/>
    <dc:identifier>SIO_001374</dc:identifier>
    <dcterms:description xml:lang="en">A brief is a written legal document used in various legal adversarial systems that is presented to a court arguing why one party to a particular case should prevail.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">brief</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/text-span">
    <dcterms:description xml:lang="en">A text span is a subset of contiguous sequence of characters of a textual entity.</dcterms:description>
    <rdfs:label xml:lang="en">text span</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/textual-entity"/>
