  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/height">
    <dc:identifier>SIO_000040</dc:identifier>
    <rdfs:label xml:lang="en">height</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/1D-extent-quantity"/>
    <dcterms:description xml:lang="en">height is the one dimensional extent along the vertical projection of a 3D object from a base plane of reference.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/small-nucleolar-RNA-%28snoRNA%29">
    <rdfs:label xml:lang="en">small nucleolar RNA (snoRNA)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/non-protein-coding-RNA-%28ncRNA%29"/>
    <dcterms:description xml:lang="en">A small nucleolar RNA (snoRNA) is a small RNA that are associated with the eukaryotic nucleus as components of small nucleolar ribonucleoproteins.</dcterms:description>
    <dcterms:alternative xml:lang="en">snoRNA</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
