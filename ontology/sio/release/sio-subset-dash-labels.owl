  <rdf:Description rdf:about="http://semanticscience.org/resource/envy">
    <dc:identifier>SIO_000834</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/negative-emotion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">envy</rdfs:label>
    <dcterms:description xml:lang="en">envy is an emotion that occurs when a person lacks another's (perceived) superior quality, achievement or possession and wishes that the other lacked it.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
