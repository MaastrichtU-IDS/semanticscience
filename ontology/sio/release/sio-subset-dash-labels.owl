    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/heterogeneous-substance"/>
    <dcterms:description xml:lang="en">A reagent is a substance that is added to a system in order to bring about a chemical reaction, or added to see if a reaction occurs.</dcterms:description>
