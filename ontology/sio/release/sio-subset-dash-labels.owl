  <rdf:Description rdf:about="http://semanticscience.org/resource/is-participant-in">
    <skos:example xml:lang="en">a car is a participant in a car race; glucose is a participant in glycolysis</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is participant in</rdfs:label>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/has-participant"/>
    <dcterms:description xml:lang="en">is participant in is a relation that describes the participation of the subject in the (processual) object.</dcterms:description>
    <dc:identifier>SIO_000062</dc:identifier>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-spatiotemporally-related-to"/>
