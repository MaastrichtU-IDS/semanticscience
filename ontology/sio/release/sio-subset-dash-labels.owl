    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-increase-the-rate-of-formation">
    <rdfs:label xml:lang="en">to increase the rate of formation</rdfs:label>
    <dc:identifier>SIO_000407</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">to increase the rate of formation is to regulate the rate of formation in a manner that increases this rate relative to a reference process.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-regulate-the-rate-of-formation"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/hostility">
    <rdfs:label xml:lang="en">hostility</rdfs:label>
    <dc:identifier>SIO_000844</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/negative-emotion"/>
    <dcterms:description xml:lang="en">Hostility is the intense negative emotion of being in conflict or opposition to someone or something.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/family-history">
