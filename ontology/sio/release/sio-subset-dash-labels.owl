    <rdfs:label xml:lang="en">ongoing</rdfs:label>
    <dc:identifier>SIO_000035</dc:identifier>
    <dcterms:description xml:lang="en">ongoing is the status of a process that is not yet complete.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/process-status"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
