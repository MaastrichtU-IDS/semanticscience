  <rdf:Description rdf:about="http://semanticscience.org/resource/diffusion">
    <dcterms:description xml:lang="en">diffusion is motion of particles at temperatures above absolute zero.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">diffusion</rdfs:label>
