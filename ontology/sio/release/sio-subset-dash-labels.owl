  <rdf:Description rdf:about="http://semanticscience.org/resource/data-point">
    <rdfs:label xml:lang="en">data point</rdfs:label>
    <dcterms:description xml:lang="en">A data point is a point that which corresponds to the projection of the values of measurement data against the axes of a statistical graph.</dcterms:description>
