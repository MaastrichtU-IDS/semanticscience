    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/end-date">
    <dcterms:description xml:lang="en">An end date is a time instant pertaining to date of the end of a process.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/time-instant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <dc:identifier>SIO_000032</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
