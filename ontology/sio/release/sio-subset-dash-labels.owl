  <rdf:Description rdf:about="http://semanticscience.org/resource/worry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/apprehension"/>
    <dc:identifier>SIO_000873</dc:identifier>
    <rdfs:label xml:lang="en">worry</rdfs:label>
    <dcterms:description xml:lang="en">worry is the emotion characterized by concer over a real or imaginary issue.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
