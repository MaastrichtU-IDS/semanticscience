  <rdf:Description rdf:about="http://semanticscience.org/resource/block-histogram">
    <rdfs:label xml:lang="en">block histogram</rdfs:label>
    <dcterms:description xml:lang="en">A block histogram contains an x-axis that is divided into bins which correspond to value ranges. Each item in the data set is drawn as a rectangular block, and the blocks are piled into the bins to show how many values in each range.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/histogram"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
