  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/a-collection-of-replicates">
    <dc:identifier>SIO_001419</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a collection of replicates is a collection composed of items that are a facsimile, reproduction, or copy of other items in the collection.</dcterms:description>
