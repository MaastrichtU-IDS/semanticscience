  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/student-role">
    <rdfs:label xml:lang="en">student role</rdfs:label>
    <dcterms:description xml:lang="en">A student role is the role of an individual that is enrolled in courses at an academic institution.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/academic-role"/>
    <rdfs:subClassOf rdf:nodeID="N694c547b67c2440baca370b366a42372"/>
