  <rdf:Description rdf:about="http://semanticscience.org/resource/irritability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/negative-emotion"/>
    <dcterms:description>irritability is the negative emotion of quick excitability to annoyance, impatience, or anger.</dcterms:description>
    <dcterms:alternative>irritable</dcterms:alternative>
