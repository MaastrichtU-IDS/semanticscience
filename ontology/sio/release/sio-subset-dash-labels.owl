    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/to-identify">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/to-investigate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_001239</dc:identifier>
    <dcterms:description xml:lang="en">to identify is the capability to determine the identity of something.</dcterms:description>
    <rdfs:label xml:lang="en">to identify</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
