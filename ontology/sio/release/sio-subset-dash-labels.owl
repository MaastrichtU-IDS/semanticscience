    <rdfs:label xml:lang="en">single nucleotide polymorphism</rdfs:label>
    <dcterms:description xml:lang="en">a single nucleotide variation (SNV) is a nucleotide residue that is a variant compared to some reference nucleic acid sequence.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/nucleotide-residue"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
