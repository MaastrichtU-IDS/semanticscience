  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/redox-reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N930f490dafd04ce8b946a956c083af26"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/chemical-reaction"/>
    <dcterms:description xml:lang="en">A redox reaction is a chemical reaction in which there is a net movement of electrons from one reactant to another.</dcterms:description>
    <dc:identifier>SIO_010509</dc:identifier>
