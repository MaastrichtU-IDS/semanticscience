  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/amorphous-carbon">
    <dcterms:description xml:lang="en">amorphous carbon is an allotrope of carbon that does not have any crystalline structure. As with all glassy materials, some short-range order can be observed, but there is no long-range pattern of atomic positions.</dcterms:description>
    <rdfs:label xml:lang="en">amorphous carbon</rdfs:label>
    <dc:identifier>SIO_010791</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/carbon-allotrope"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/biochemical-reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A biochemical reaction is a biochemical process that involves the conversion of at least one chemical participant (target) into another (product) by an enzyme (agent).</dcterms:description>
    <ns1:equivalentTo>biopax:BiochemicalReaction</ns1:equivalentTo>
    <ns1:equivalentTo>biopax:Conversion</ns1:equivalentTo>
    <dc:identifier>SIO_010036</dc:identifier>
