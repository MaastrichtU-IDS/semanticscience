  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/spatial-boundary">
    <rdfs:label xml:lang="en">spatial boundary</rdfs:label>
    <dc:identifier>SIO_000783</dc:identifier>
    <dcterms:description xml:lang="en">A spatial boundary is the closure minus the interior of a subset of a topological space.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/spatial-region"/>
