  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/amino-acid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">An amino acid is an organic molecule composed of a carbon bonded to four different groups: a carboxyl group, an amino group, an R group, and a hydrogen atom. In the case of glycine, the R group is another hydrogen atom.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/organic-molecule"/>
    <rdfs:label xml:lang="en">amino acid</rdfs:label>
    <dc:identifier>SIO_001224</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/nurse-role">
    <dc:identifier>SIO_000714</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/medical-role"/>
    <dcterms:description xml:lang="en">A nurse role is the role of an individual that is involved in the protection, promotion, and optimization of health and abilities, prevention of illness and injury, alleviation of suffering through the diagnosis and treatment of human response, and advocacy in the care of individuals, families, communities, and populations.</dcterms:description>
    <rdfs:label xml:lang="en">nurse role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/exclusion-criterion">
    <dc:identifier>SIO_000143</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/criterion"/>
    <dcterms:description xml:lang="en">An exclusion criterion is a criterion that must be absent to satistify the objective.</dcterms:description>
    <rdfs:label xml:lang="en">exclusion criterion</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/mendelevium-atom">
    <dc:identifier>SIO_011115</dc:identifier>
