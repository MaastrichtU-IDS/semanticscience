    <rdfs:label xml:lang="en">node</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a node or vertex is a point in a graph.</dcterms:description>
    <dcterms:alternative xml:lang="en">vertex</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/point"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/clause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A clause consists of a subject and a predicate.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/sentence"/>
    <rdfs:label xml:lang="en">clause</rdfs:label>
    <dc:identifier>SIO_000493</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
