  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/passive-transport">
    <dcterms:description xml:lang="en">passive transport is the movement of a substance across a membrane and does not require chemical energy.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/membrane-transport"/>
