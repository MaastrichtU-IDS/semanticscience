  <rdf:Description rdf:about="http://semanticscience.org/resource/is-paralogous-to">
    <dcterms:description xml:lang="en">is paralogous to is a relation between two entities which indicates their common ancestry as a result of a gene duplication.</dcterms:description>
    <dc:identifier>SIO_000630</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is paralogous to</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-homologous-to"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/consensus">
    <dcterms:description xml:lang="en">consensus is an acceptable resolution, one that can be supported, even if not the preferred outcome for each individual.</dcterms:description>
    <dc:identifier>SIO_001198</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">consensus</rdfs:label>
