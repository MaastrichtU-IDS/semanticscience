    <dcterms:description xml:lang="en">regulation of a participant quantity is the regulation of a process in which the quantity of its partcipants is changed.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
