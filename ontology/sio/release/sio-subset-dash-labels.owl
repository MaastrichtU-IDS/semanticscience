  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/sign-language">
    <dcterms:description xml:lang="en">A sign language (also signed language) is a language that involves manual communication and body language to convey meaning. This can involve simultaneously combining hand shapes, orientation and movement of the hands, arms or body, and facial expressions to fluidly express a speaker's thoughts.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>SIO_000980</dc:identifier>
    <rdfs:label xml:lang="en">sign language</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/language"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-dash-labels.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/is-greater-than-or-equal-to">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:identifier>SIO_000699</dc:identifier>
    <dcterms:description xml:lang="en">is greater than or equal to is a comparison relation between two quantities in which the first has a value larger or equal to the second.</dcterms:description>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/is-numerically-comparable-to"/>
    <owl:inverseOf rdf:resource="http://semanticscience.org/resource/is-lesser-than-or-equal-to"/>
