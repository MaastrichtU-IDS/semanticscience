    <rdfs:label xml:lang="en">scalar</rdfs:label>
    <dcterms:alternative xml:lang="en">rank 0 tensor</dcterms:alternative>
    <dcterms:description xml:lang="en">a scalar is a rank 0 tensor and is an element of a field that is used to define a vector space.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
