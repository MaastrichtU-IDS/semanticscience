    <dcterms:description xml:lang="en">a chemical-pathway association is an association between a chemical and a pathway.</dcterms:description>
    <dcterms:alternative xml:lang="en">drug-pathway association</dcterms:alternative>
    <rdfs:label xml:lang="en">chemical-pathway association</rdfs:label>
