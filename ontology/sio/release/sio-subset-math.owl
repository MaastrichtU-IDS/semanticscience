  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000952">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A default parameter is a parameter which has a default value.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000144"/>
    <rdfs:label xml:lang="en">default parameter</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000158">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000295"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A book series is a collection of books that have been sequentially published.</dcterms:description>
