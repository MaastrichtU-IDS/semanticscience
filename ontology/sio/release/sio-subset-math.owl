    <rdfs:label xml:lang="en">polar coordinate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A polar coordinate is a position characterized by a distance from a fixed point and an angle from a fixed direction.</dcterms:description>
