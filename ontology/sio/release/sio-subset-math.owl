  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001407">
    <rdfs:label xml:lang="en">surface area</rdfs:label>
    <dcterms:description xml:lang="en">The surface area of a is a measure of the total area that the surface of the object occupies.</dcterms:description>
