    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
    <dcterms:description xml:lang="en">age is the length of time that a person has lived or a thing has existed.</dcterms:description>
    <rdfs:label xml:lang="en">age</rdfs:label>
