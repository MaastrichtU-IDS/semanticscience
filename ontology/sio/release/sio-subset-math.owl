    <dcterms:description xml:lang="en">a duplicate is an object that is an exact copy of another item</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001259"/>
