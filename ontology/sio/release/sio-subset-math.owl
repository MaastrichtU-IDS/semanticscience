    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">number</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001431"/>
    <dcterms:alternative xml:lang="en">rank 0 tensor</dcterms:alternative>
