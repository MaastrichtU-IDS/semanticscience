mark wilkinson
karin verspoor
natalia villanueva-rosales</dc:contributor>
    <dc:creator xml:lang="en">Michel Dumontier</dc:creator>
    <dcterms:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://orcid.org/0000-0003-4727-9435</dcterms:creator>
    <dcterms:description xml:lang="en">The semanticscience integrated ontology (SIO) provides a simple, integrated ontology (types, relations) for objects, processes and their attributes.

This project provides foundational support for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects. 

website: http://semanticscience.org
email: sio-ontology@googlegroups.com
mailing list: http://groups.google.com/group/sio-ontology
</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-03-29</dcterms:issued>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:rights>free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/4.0/].</dcterms:rights>
    <dcterms:title xml:lang="en">Semanticscience Integrated Ontology (SIO)</dcterms:title>
    <ns2:citesAsAuthority rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.jbiomedsem.com/content/5/1/14</ns2:citesAsAuthority>
    <vann:preferredNamespacePrefix xml:lang="en">sio</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://semanticscience.org/resource/</vann:preferredNamespaceUri>
    <rdfs:comment>general class inclusion axioms:
'is part of' some 'physical entity' subClassOf 'is located in' some 'physical entity'

role chains:
'has capability' o 'is realized in' -&gt; 'is participant in'</rdfs:comment>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://sio.semanticscience.org</rdfs:seeAlso>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
    <dc:identifier>sio.owl</dc:identifier>
    <owl:versionInfo>sio-subset-math.owl</owl:versionInfo>
    <owl:versionIRI rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001122">
    <dcterms:alternative>gene variant-disease association</dcterms:alternative>
    <rdfs:label xml:lang="en">gene-disease association linked with genetic variation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001350"/>
    <dcterms:description xml:lang="en">A gene-disease association in which a sequence variation (a mutation, a SNP) is associated with the disease.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000121">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:equivalentTo>http://purl.org/ontology/bibo/Magazine</ns1:equivalentTo>
    <dcterms:description xml:lang="en">A magazine is a periodical that typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports.</dcterms:description>
    <rdfs:label xml:lang="en">magazine</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000162"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000281">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">NOT is a logical operator in that has the value true if its operand is false.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000238"/>
    <rdfs:label xml:lang="en">negation (not)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001327">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
    <dcterms:description xml:lang="en">A protein expression value is a quantity obtained from a protein expression experiment.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">protein expression value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000546">
    <dcterms:description xml:lang="en">A collection of points is a geometric entity that contains a non-zero set of geometric points. </dcterms:description>
    <rdfs:label xml:lang="en">collection of points</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000983">
    <dcterms:description xml:lang="en">A gene-disease association is an association between a gene and a disease.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene-disease association</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010061">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">generation number</rdfs:label>
    <dcterms:description xml:lang="en">generation number is a count of the number of biological reproduction events elapsed from some starting reference point.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000767">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">postal code</rdfs:label>
    <dcterms:description xml:lang="en">A postal code is a geographic coordinate composed of a series of letters and/or digits appended to a postal address for the purpose of sorting mail.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000013"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000039">
    <rdfs:label xml:lang="en">depth</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000038"/>
    <dcterms:description xml:lang="en">depth is the dimensional extent into a plane of a 3D projection of the object.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000638">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000257"/>
    <dcterms:description xml:lang="en">A probability measure is quantity of how likely it is that some event will occur.</dcterms:description>
    <rdfs:label xml:lang="en">probability measure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001382">
    <dc:description xml:lang="en">a unigene cluster is a collection of transcripts (ESTs and mRNAs) that map to a particular genomic region.</dc:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">cluster of transcripts</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:label xml:lang="en">unigene cluster</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000049">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000048"/>
    <dcterms:description xml:lang="en">volume is the quantity of three-dimensional space enclosed by some closed boundary.</dcterms:description>
    <rdfs:label xml:lang="en">volume</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000032">
    <dcterms:description xml:lang="en">An end date is a time instant pertaining to date of the end of a process.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000072">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A Cartesian coordinate is the signed distance of a point to some referent line.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000071"/>
    <rdfs:label xml:lang="en">cartesian coordinate</rdfs:label>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000073"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001171">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">database cross-reference</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <dcterms:description xml:lang="en">A database cross-reference is an association between one data item and another.</dcterms:description>
    <dcterms:alternative>dbxref</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000257">
    <rdfs:label xml:lang="en">dimensionless quantity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A dimensionless quantity is a quantity that has no associated unit.</dcterms:description>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000052">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000070"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quantity</rdfs:label>
    <dcterms:description xml:lang="en">A quantity is an informational entity that gives the magnitude of a property.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001419">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a collection of replicates is a collection composed of items that are a facsimile, reproduction, or copy of other items in the collection.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:label xml:lang="en">a collection of replicates</rdfs:label>
    <dcterms:alternative xml:lang="en">replicates</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001162">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A difference in number of objects produced is a count of the number of objects produced with respect to a second variable (space, time, etc)</dcterms:description>
    <rdfs:label xml:lang="en">difference in number of objects produced</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000791">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000789"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000943"/>
    <dcterms:description xml:lang="en">A sequence start position is the start position for a sequence of characters.</dcterms:description>
    <rdfs:label xml:lang="en">sequence start position</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001408">
    <rdfs:label xml:lang="en">aspect ratio</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">The aspect ratio of a geometric shape is the ratio of its sizes in different dimensions.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000041">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000038"/>
    <rdfs:label xml:lang="en">length</rdfs:label>
    <dcterms:description xml:lang="en">length is the longer dimensional extent along a 2D projection of the object.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001246">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interval</rdfs:label>
    <skos:example xml:lang="en">The set of all numbers x satisfying 0&lt;=x&lt;=1 is an interval which contains 0 and 1, as well as numbers between them.</skos:example>
    <dcterms:description xml:lang="en">an interval is a set of real numbers with the property that any number that lies between two numbers in the set is also included in the set.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000289"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001118">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A sequence is an ordered list of entities. Like a set, it contains members (also called elements, or terms).</dcterms:description>
    <dcterms:alternative>ordered list</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000150"/>
    <rdfs:label xml:lang="en">sequence</rdfs:label>
    <skos:example xml:lang="en">For example, (M, A, R, Y) is a sequence of letters that differs from (A, R, M, Y), as the ordering matters, and (1, 1, 2, 3, 5, 8), which contains the number 1 at two different positions, is a valid sequence. </skos:example>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001058">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001072"/>
    <rdfs:label xml:lang="en">word end position</rdfs:label>
    <dcterms:description xml:lang="en">word end position is the position of the last character in a word as an offset from the first character of the text in which it is found.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000418">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000391"/>
    <dcterms:description xml:lang="en">A time instant is a temporal region which occurs instantaneously, e.g. having no duration.</dcterms:description>
    <rdfs:label xml:lang="en">time instant</rdfs:label>
    <skos:example xml:lang="en">at this moment; the moment at which a finger is detached in an industrial accident; the moment at which a child is born; the moment of death</skos:example>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001316">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000150"/>
    <rdfs:label xml:lang="en">ordered list</rdfs:label>
    <dcterms:description>an ordered list is a list in which items are sequentially ordered.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000238">
    <dcterms:description xml:lang="en">A logical operator is a unary or binary relation to construct logical expressions.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdfs:label xml:lang="en">logical operator</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001110">
    <rdfs:label xml:lang="en">median</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001108"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A median is the numerical value separating the higher half of a sample, a population, or a probability distribution, from the lower half. </dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000160">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000162"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">journal</rdfs:label>
    <dcterms:description xml:lang="en">A journal is a a peer-reviewed periodical in which scholarship relating to a particular academic discipline is published.</dcterms:description>
    <ns1:equivalentTo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.org/ontology/bibo/Journal</ns1:equivalentTo>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001112">
    <rdfs:label xml:lang="en">sum</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <dcterms:description xml:lang="en">A sum is the result of adding a set of values together.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001352">
    <dcterms:description xml:lang="en">The DisGeNET pleiotropy index is a measure of specificity as it pertains to classes of disease. The disease pleotropy index is computed from the ratio of the number of disease classes associated with an entity over the total number of disease classes multplied by 100. 

The measure is defined here: http://www.disgenet.org/web/DisGeNET/menu/dbinfo#pleiotropy</dcterms:description>
    <rdfs:label xml:lang="en">DisGeNET Pleiotropy Index</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000279">
    <rdfs:label xml:lang="en">mass</rdfs:label>
    <dcterms:description xml:lang="en">mass is the quality of the amount of substance.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000037"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000435">
    <dcterms:description xml:lang="en">A second (symbol: s) is the base unit of time in the International System of Units (SI) and is the second division of the hour by sixty, the first division by 60 being the minute.</dcterms:description>
    <rdfs:label xml:lang="en">second</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000043">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000039"/>
    <rdfs:label xml:lang="en">thickness</rdfs:label>
    <dcterms:description xml:lang="en">thickness is the shortest dimensional extent of a 3D projection of an object.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001441">
    <rdfs:label xml:lang="en">imaginary number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001443"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_001442"/>
    <dcterms:description xml:lang="en">An imaginary number is a complex number whose real part is zero e.g. 0 + bi, and is expressed as a multiple of the square root of -1.</dcterms:description>
    <ns1:example xml:lang="en">5i is an imaginary number, and its square is -25.</ns1:example>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000569">
    <dcterms:description xml:lang="en">A differential equation is a mathematical equation for an unknown function of one or several variables that relates the values of the function itself and its derivatives of various orders.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000368"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">differential equation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001259">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a collection item is an item in a collection.</dcterms:description>
    <rdfs:label xml:lang="en">collection item</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001258"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001328">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">copy number variation</rdfs:label>
    <dcterms:alternative xml:lang="en">CNV</dcterms:alternative>
    <dcterms:description xml:lang="en">copy number variation refers to the number of deletions/duplications of a DNA region as compared to some reference state.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001120">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000983"/>
    <dcterms:description xml:lang="en">A gene disease association in which the gene is a therapeutic marker for the disease.</dcterms:description>
    <dcterms:alternative>gene-disease association arising from a therapeutic role of the gene/protein</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">therapeutic gene-disease association</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000046">
    <rdfs:label xml:lang="en">length of perimeter</rdfs:label>
    <dcterms:description xml:lang="en">A perimeter is a length of the outline that surrounds a two-dimensional shape. </dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000044"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000417">
    <dcterms:description xml:lang="en">A time internval is a contiguous temporal region having some duration.</dcterms:description>
    <rdfs:label xml:lang="en">time interval</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000391"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000439">
    <rdfs:label xml:lang="en">center of mass</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000056"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">The center of mass (aka barycenter) is the weighted average location of all the mass in a body or group of bodies.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001241">
    <rdfs:label xml:lang="en">catalog</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">registry</dcterms:alternative>
    <dcterms:description xml:lang="en">A catalog is a systemic collection of items of the same type.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000402">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A z cartesian coordinate is the coordinate of an object onto the z-axis of a cartesian coordinate system.</dcterms:description>
    <rdfs:label xml:lang="en">z cartesian coordinate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000072"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000094">
    <dcterms:description xml:lang="en">An algorithm is an effective method expressed as a finite list of well-defined instructions for calculating a function.</dcterms:description>
    <rdfs:label xml:lang="en">algorithm</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000308">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">edition number</rdfs:label>
    <dcterms:description xml:lang="en">An edition number is count of a literary work edited and published, as by a certain editor or in a certain manner including being printed during some interval of time.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001443">
    <rdfs:label xml:lang="en">complex number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000366"/>
    <dcterms:description xml:lang="en">a complex number is an element of a number system that extends the real numbers with an imaginary unit i. Every complex number can be expressed in the form a + bi, where a and b are real numbers.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000616">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collection</rdfs:label>
    <dcterms:description xml:lang="en">A collection is a set for which there exists at least one member, although any member need not to exist at any point in the collection's existence.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000289"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001252">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001246"/>
    <dcterms:description xml:lang="en">a right open interval is an interval in which there is no element that is greater than all other elements.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">right open interval</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000044">
    <dcterms:description xml:lang="en">A quantity that extends in two dimensions.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000037"/>
    <rdfs:label xml:lang="en">2D extent quantity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000898">
    <dcterms:description xml:lang="en">A statistical association is any relationship between two measured quantities that renders them statistically dependent.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdfs:label xml:lang="en">statistical association</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001162"/>
    <dcterms:description xml:lang="en">An increase in the number of objects produced is the positive value of a difference in number of objects produced.</dcterms:description>
    <rdfs:label xml:lang="en">increase in number of objects produced</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000047">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000046"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">circumference is the length of the outline of a circle or ellipse. it is defined as c = 2*pi*r, where r is the radius.</dcterms:description>
    <rdfs:label xml:lang="en">circumference</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000038">
    <dcterms:description xml:lang="en">A quantity that extends in single dimension.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000037"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">1D extent quantity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000669">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">start time</rdfs:label>
    <dcterms:description xml:lang="en">A start time is a time instant pertaining to the time at which a process begins.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001437">
    <rdfs:comment xml:lang="en">A gene-gene association is an association between two genes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdfs:label xml:lang="en">gene-gene association</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001421">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">duplicates</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <dcterms:description xml:lang="en">a collection of duplicates is a collection composed of items that are an exact copy of other items in the collection.</dcterms:description>
    <rdfs:label xml:lang="en">a collection of duplicates</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000144">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A parameter is variable whose value changes the characteristics of a system or a function.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000920"/>
    <rdfs:label xml:lang="en">parameter</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000130">
    <dcterms:description xml:lang="en">A pattern is a generalized representation of some repeatable concrete or informational item.</dcterms:description>
    <rdfs:label xml:lang="en">pattern</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001314">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <rdfs:label xml:lang="en">date of issue</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description>the date at which an information content entity was made public.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000056">
    <dcterms:description xml:lang="en">A measurement of a spatial location relative to a frame of reference or other objects.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">position</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000070"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001164">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001162"/>
    <rdfs:label xml:lang="en">decrease in number of objects produced</rdfs:label>
    <dcterms:description xml:lang="en">An decrease in the number of objects produced is the negative value of a difference in number of objects produced.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001074">
    <dcterms:description xml:lang="en">A t-statistic is a ratio of the departure of an estimated parameter from its notional value and its standard error. </dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:label xml:lang="en">t-statistic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000239">
    <dcterms:description xml:lang="en">AND is a logical operator that has the value true if both of its operands are true, otherwise a value of false.</dcterms:description>
    <rdfs:label xml:lang="en">conjunction (and)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000238"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001119">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001122"/>
    <rdfs:label xml:lang="en">gene-disease association linked with causal mutation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A gene-variant disease association in which a mutation in the gene/protein results in the development or maintenance of the disease.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010068">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pairwise sequence alignment</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010066"/>
    <dcterms:description xml:lang="en">A pairwise sequence alignment is the alignment of exactly 2 sequences.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001349">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001350"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene-disease association linked with chromosomal rearrangement</rdfs:label>
    <dcterms:description xml:lang="en">A gene-disease association in which the gene is included in a chromosomal rearrangement associated with a particular manifestation of the disease.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000464">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000150"/>
    <dcterms:description xml:lang="en">A data series is a data set composed of related values displayed in a statistical graph.</dcterms:description>
    <rdfs:label xml:lang="en">data series</rdfs:label>
    <skos:example xml:lang="en">Example: The two series that correspond to "Seasonally adjusted" and "Trend" are composed of the seasonally adjusted value of permits in each month and values from a trend derived from some mathematical tranformation across those values, respectively, in  Graph 1 of http://tinyurl.com/opwnvm</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000305">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000613"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">process number</rdfs:label>
    <dcterms:description xml:lang="en">process number is a number associated with a process that denotes its ordinal position in a set of processes.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000792">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000789"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000953"/>
    <rdfs:label xml:lang="en">sequence end position</rdfs:label>
    <dcterms:description xml:lang="en">A sequence end position is the position of the last character in a sequence of characters relative to some linear frame of reference.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000318">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">longitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000013"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000319"/>
    <dcterms:description xml:lang="en">Longitude is a geographic position that refers to  the angle east or west of a reference meridian between the two geographical poles to another meridian that passes through an arbitrary point.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000289">
    <dcterms:description xml:lang="en">A set is a collection of entities, for which there may be zero members.</dcterms:description>
    <rdfs:label xml:lang="en">set</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001442">
    <dcterms:description xml:lang="en">a real number is a complex number whose imaginary part is zero, e.g. a + 0i.</dcterms:description>
    <rdfs:label xml:lang="en">real number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001443"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000131">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sequence motif</rdfs:label>
    <dcterms:description xml:lang="en">A sequence motif is a pattern of nucleotides in a DNA sequence or amino acids in a protein.</dcterms:description>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_001197"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000130"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001351">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:label xml:lang="en">DisGeNET disease specificity</rdfs:label>
    <dcterms:description xml:lang="en">DisGeNET Disease specificity is a measure of disease coverage. It is calculated from the negative base 2 log of the ratio of number of diseases associated to the total number of diseases.

The measure is described here: http://www.disgenet.org/web/DisGeNET/menu/dbinfo#specificity</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000428">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">year</rdfs:label>
    <dcterms:description xml:lang="en">A year is a period of time taken by a planet to make one revolution around the sun.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010531">
    <dcterms:description xml:lang="en">A sequence profile is provides the preference for a character at each position of an abstracted sequence.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000130"/>
    <rdfs:label xml:lang="en">sequence profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001430">
    <rdfs:label xml:lang="en">vector</rdfs:label>
    <dcterms:alternative xml:lang="en">rank 1 tensor</dcterms:alternative>
    <dcterms:description xml:lang="en">a vector is a rank 1 tensor that is described by n-dimension of scalars.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001434"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000071">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000056"/>
    <dcterms:description xml:lang="en">A coordinate is a measurement of position in n-dimensional space.</dcterms:description>
    <rdfs:label xml:lang="en">coordinate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001406">
    <dcterms:description xml:lang="en">Density (volumetric mass density) is the quantity of mass per unit volume of a substance.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">density</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000048"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000429">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A month is a period of time that divides the year.</dcterms:description>
    <rdfs:label xml:lang="en">month</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000789">
    <dcterms:description xml:lang="en">A sequence element position is the position of an element of a linear sequence.</dcterms:description>
    <rdfs:label xml:lang="en">sequence element position</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000788"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001070">
    <dcterms:alternative>controlled variable</dcterms:alternative>
    <dcterms:alternative>extraneous variable</dcterms:alternative>
    <dcterms:description xml:lang="en">A control variable that is believed to alter the dependent or independent variables, but may not actually be the focus of the experiment. So that variable will be kept constant or monitored to try to minimise its effect on the experiment.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000367"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">control variable</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001439">
    <rdfs:comment xml:lang="en">A protein-disease association is an association between a protein and a disease.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">protein-disease association</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000613">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A ordinal position is a number that designates the position of an entity from the first entity in an ordered sequence of entities.</dcterms:description>
    <rdfs:label xml:lang="en">ordinal position</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000788"/>
    <dcterms:alternative>offset</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001433">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001434"/>
    <dcterms:description xml:lang="en">a matrix is a rank 2 tensor. It is represented as a rectangular array or table of numbers, symbols, or expressions arranged in rows and columns.</dcterms:description>
    <rdfs:label xml:lang="en">matrix</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">rank 2 tensor</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010066">
    <rdfs:label xml:lang="en">sequence alignment</rdfs:label>
    <dcterms:description xml:lang="en">A sequence alignment is the character-based alignment of sequences using some method.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000367">
    <rdfs:label xml:lang="en">variable</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A variable is a value that may change within the scope of a given problem or set of operations.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001257">
    <rdfs:label xml:lang="en">chemical-gene association</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <dcterms:description xml:lang="en">a chemical-gene association is an association between a chemical and a gene.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001429">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a tensor is a n-dimensional array.</dcterms:description>
    <rdfs:label xml:lang="en">tensor</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000770">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdfs:label xml:lang="en">standard deviation</rdfs:label>
    <dcterms:description xml:lang="en">A standard deviation (represented by the symbol σ) is the quantity of  variation from the average (mean, or expected value).</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001434">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001429"/>
    <rdfs:label xml:lang="en">rank nonzero tensor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">a rank nonzero tensor is a tensor with a rank greater than zero.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001123">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A gene-disease association in which the disease phenotype is associated with an altered expression of the gene.</dcterms:description>
    <rdfs:label xml:lang="en">gene-disease association linked with altered gene expression</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001121"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001083">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <dcterms:description xml:lang="en">A date of database submission refers to the moment in time in which some information was submitted/received to a database system.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">date of database submission</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001368">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001365"/>
    <rdfs:label xml:lang="en">speed</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">Speed is the rate of change of an object's position.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000162"/>
    <dcterms:description xml:lang="en">A newspaper is a periodical publication containing news regarding current events, informative articles, diverse features, editorials, and advertising.</dcterms:description>
    <rdfs:label xml:lang="en">newspaper</rdfs:label>
    <ns1:equivalentTo>http://purl.org/ontology/bibo/Newspaper</ns1:equivalentTo>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000150">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000289"/>
    <dcterms:description xml:lang="en">A list is any enumeration of a set of items.</dcterms:description>
    <rdfs:label xml:lang="en">list</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000258">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">dimensional quantity</rdfs:label>
    <dcterms:description xml:lang="en">A dimensional quantity is a quantity that has an associated unit.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000787">
    <rdfs:label xml:lang="en">page number</rdfs:label>
    <dcterms:description xml:lang="en">A page number is the count of a page in a sequence of pages.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000765">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:alternative xml:lang="en">p-value</dcterms:alternative>
    <rdfs:label xml:lang="en">probability value</rdfs:label>
    <dcterms:description xml:lang="en">A p-value or probability value is the probability of obtaining a test statistic at least as extreme as the one that was actually observed, assuming that the null hypothesis is true</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000638"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001072">
    <dcterms:description>text span end position is the position (offset) of the last character of a text span in relation the text it is from.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000953"/>
    <rdfs:label xml:lang="en">text span end position</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000031">
    <dcterms:description xml:lang="en">A start date is a time instant pertaining to the date of the beginning of a process.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000178">
    <rdfs:label xml:lang="en">page total</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <dcterms:description xml:lang="en">A page total is a textual entity that is about the number of pages in some informational entity.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001254">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001246"/>
    <dcterms:description xml:lang="en">a left closed interval is an interval in which there is a real number that is smaller than all its elements.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">left closed interval</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000670">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000418"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">end time</rdfs:label>
    <dcterms:description xml:lang="en">An end time is a time instant pertaining to the time at which a process ends.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000438">
    <rdfs:label xml:lang="en">altitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000056"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">Altitude is a distance above sea level.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001018">
    <dcterms:description xml:lang="en">A ratio is a relationship between two numbers of the same kind expressed arithmetically as a dimensionless quotient of the two which explicitly indicates how many times the first number contains the second.</dcterms:description>
    <rdfs:label xml:lang="en">ratio</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000257"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000296">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A website is a collection of documents published on the World Wide Web.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000295"/>
    <rdfs:label xml:lang="en">website</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000769">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">uncertainty value</rdfs:label>
    <dcterms:description xml:lang="en">The uncertainty value (margin of error) of a measurement is a range of values likely to enclose the true value. </dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001248">
    <skos:example xml:lang="en">(0,1) is an open interval that is greater than 0 and less than 1.</skos:example>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001251"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001252"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">an open interval is an interval that does not include its endpoints.</dcterms:description>
    <rdfs:label xml:lang="en">open interval</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001117">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000150"/>
    <dcterms:description xml:lang="en">An intersection is a list of only the values of an attribute for the entities in the defined set where all entities have that value.</dcterms:description>
    <rdfs:label xml:lang="en">intersection</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001414">
    <dcterms:description xml:lang="en">A quantile is a quantity that divides the range of a probability distribution into continuous intervals with equal probabilities, or dividing the observations in a sample in the same way.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quantile</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000257"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000433">
    <rdfs:label xml:lang="en">hour</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <dcterms:description xml:lang="en">An hour is a period of 60 minutes.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000568">
    <rdfs:label xml:lang="en">partial differential equation</rdfs:label>
    <dcterms:description xml:lang="en">A partial differential equation (PDE) is a differential equation in which the unknown function is a function of multiple independent variables and the equation involves its partial derivatives.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000569"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000943">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A start position is the proximal position of an object relative to an origin in a linear system.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000788"/>
    <rdfs:label xml:lang="en">start position</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000319">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000013"/>
    <rdfs:label xml:lang="en">latitude</rdfs:label>
    <dcterms:description xml:lang="en">Latitude is a geographic coordinate which refers to the angle from a point on the Earth's surface to the equatorial plane</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001020">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001019"/>
    <dcterms:description xml:lang="en">effective dose is the amount of a substance required to produce an effect on a predefined percentage of a population.</dcterms:description>
    <rdfs:label xml:lang="en">effective dose</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000162">
    <rdfs:label xml:lang="en">periodical</rdfs:label>
    <dcterms:description xml:lang="en">A periodical is a publication that appears on a regular schedule.</dcterms:description>
    <ns1:equivalentTo>http://purl.org/ontology/bibo/Periodical</ns1:equivalentTo>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000295"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001253">
    <dcterms:description xml:lang="en">a right closed interval is an interval in which there is a real number that is larger than all of its elements.</dcterms:description>
    <rdfs:label xml:lang="en">right closed interval</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001246"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001109">
    <dcterms:alternative>average</dcterms:alternative>
    <dcterms:alternative>arithmeritic mean</dcterms:alternative>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mean</rdfs:label>
    <dcterms:description xml:lang="en">A mean is the central tendency of a collection of numbers taken as the sum of the numbers divided by the size of the collection.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001108"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001436">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A disease-disease association is an association between two diseases.</rdfs:comment>
    <rdfs:label xml:lang="en">disease-disease association</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001082">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A t-statistic based decreased differential gene expression is a differential gene expression ratio in which the t-statistic is less than zero.</dcterms:description>
    <rdfs:label xml:lang="en">t-statistic based decreased differential gene expression</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001078"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000897">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">association</rdfs:label>
    <dcterms:description xml:lang="en">An association is a relationship between two or more entities derived by some informational analysis.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000309">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000794"/>
    <rdfs:label xml:lang="en">volume number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">volume number is a count of a sequence of periodicals.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001245">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000638"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">standard score</rdfs:label>
    <dcterms:description xml:lang="en">A standard score is the (signed) number of standard deviations an observation or datum is above the mean. </dcterms:description>
    <dcterms:alternative xml:lang="en">z-value, z-score, normal score, standardadized variable.</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000045">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">area is a quantity that pertains to the extent of a two-dimensional surface or shape, or planar lamina, in the plane.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000044"/>
    <rdfs:label xml:lang="en">area</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001348">
    <dcterms:description xml:lang="en">A gene-disease association in which the fusion between two different genes (promotor and/or other coding DNA regions) is associated with the disease.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001350"/>
    <rdfs:label xml:lang="en">fusion gene-disease association</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001113">
    <dcterms:alternative>min</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdfs:label xml:lang="en">minimal value</rdfs:label>
    <dcterms:description xml:lang="en">A minimal value is smallest value of an attribute for the entities in the defined set.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000566">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000368"/>
    <dcterms:description xml:lang="en">A movement equation describes the displacement of an object in space over time.</dcterms:description>
    <rdfs:label xml:lang="en">movement equation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000282">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000280"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">exclusive disjunction (xor)</rdfs:label>
    <dcterms:description xml:lang="en">XOR, also called exclusive disjunction or (symbolized XOR, EOR, EXOR, or ⊕), is a type of logical disjunction on two operands that results in a value of true if exactly one of the operands has a value of true.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000944">
    <dcterms:description xml:lang="en">An interval is a set of real numbers that includes all numbers between any two numbers in the set.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdfs:label xml:lang="en">interval</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001108">
    <dcterms:description xml:lang="en">A central tendency measure is a central value or a typical value for a probability distribution.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
    <rdfs:label xml:lang="en">centrality measure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001056">
    <rdfs:label xml:lang="en">character position</rdfs:label>
    <dcterms:alternative>character offset</dcterms:alternative>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000613"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">The ordinal position of a character in a sequence of characters.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000432">
    <rdfs:label xml:lang="en">millennium</rdfs:label>
    <dcterms:description xml:lang="en">A millenium is a period of 1000 years</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000040">
    <rdfs:label xml:lang="en">height</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000038"/>
    <dcterms:description xml:lang="en">height is the one dimensional extent along the vertical projection of a 3D object from a base plane of reference.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000070">
    <dcterms:description xml:lang="en">A measurement value is a quantitative description that reflects the magnitude of some attribute.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000366"/>
    <rdfs:label xml:lang="en">measurement value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001367">
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <dcterms:description xml:lang="en">Frequency is the number of occurrences of a repeating event per unit time</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001365"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000280">
    <dcterms:description>OR is a logical operator that results in true whenever one or more of its operands are true.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">disjunction (or)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000238"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001260">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001258"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">list item</rdfs:label>
    <dcterms:description>a list item is an item in a list.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001121">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000983"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gene-disease biomarker association</rdfs:label>
    <dcterms:description xml:lang="en">A gene-disease association in which the gene/protein is involved in the etiology or maintenance of the disease.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010067">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_010066"/>
    <dcterms:description xml:lang="en">A multiple sequence alignment is a sequence alignment involving more than two sequences.</dcterms:description>
    <rdfs:label xml:lang="en">multiple sequence alignment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000333">
    <rdfs:label xml:lang="en">3D cartesian coordinate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000072"/>
    <dcterms:description xml:lang="en">A 3D cartesian coordinate is a coordinate that is composed of an x, y and z coordinate.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000920">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">independent variable</rdfs:label>
    <dcterms:description xml:lang="en">An independent variable is a variable that may take on different values independent of other elements in a system.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000367"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001344">
    <dcterms:description xml:lang="en">A gene-variant disease association in which a germline mutation in the gene/protein results in the development or maintenance of the disease, and it may be passed on to offspring.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001119"/>
    <rdfs:label xml:lang="en">gene-disease association linked with germline causal mutation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001249">
    <rdfs:label xml:lang="en">closed interval</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001253"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001254"/>
    <skos:example xml:lang="en">[0,1] is a closed interval that is greater than or equal to 0 and less than or equal to 1.</skos:example>
    <dcterms:description xml:lang="en">A closed interval is an interval that includes its endpoints, and is denoted with square brackets.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000013">
    <dcterms:description xml:lang="en">A geographic position is the coordinate of an entity against some geographic coordinate system.</dcterms:description>
    <rdfs:label xml:lang="en">geographic position</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000056"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001440">
    <rdfs:label xml:lang="en">chemical-protein association</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A chemical-protein association is an association between a chemical and a protein.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001415">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001414"/>
    <rdfs:label xml:lang="en">percentile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A percentile (or a centile) is a quantile that divides the given probability distribution, or sample, into 100 equal-sized intervals.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001172">
    <rdfs:label xml:lang="en">exact cross-reference</rdfs:label>
    <dcterms:description xml:lang="en">An exact cross-reference is a database cross-reference in which one entity is equivalent to the other based on all the entitie's attributes (minus the source).</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001171"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001347">
    <rdfs:label xml:lang="en">gene-disease association linked with germline modifying mutation</rdfs:label>
    <dcterms:description xml:lang="en">A gene-variant disease association in which a germline mutation in the gene modifies the clinical presentation of the disease, and it may be passed on to offspring.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001342"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001057">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">word start position</rdfs:label>
    <dcterms:description xml:lang="en">The position of the first character in a word as an offset from the first character of the text in which it is found.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001071"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000037">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A spatial quantity is a quantity obtained from measuring the spatial extent of an entity </dcterms:description>
    <rdfs:label xml:lang="en">spatial quantity</rdfs:label>
    <dcterms:alternative xml:lang="en">physical dimensional quantity</dcterms:alternative>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001342">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001122"/>
    <dcterms:description xml:lang="en">A gene-disease association in which a gene mutation is known to modify the clinical presentation of the disease.</dcterms:description>
    <rdfs:label xml:lang="en">gene-disease association linked with modifying mutation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000921">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000367"/>
    <dcterms:description xml:lang="en">A dependent variable is one whose value changes as a consequence of changes in other values in the system.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">dependent variable</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001078">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:label xml:lang="en">differential gene expression ratio</rdfs:label>
    <dcterms:description xml:lang="en">A differential gene expression ratio is the ratio of gene expression values from a test sample compared to a control sample.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001116">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000150"/>
    <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_001117"/>
    <rdfs:label xml:lang="en">union</rdfs:label>
    <dcterms:description xml:lang="en">A union is a list of all of the values of an attribute for the entities in the defined set.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000295">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000616"/>
    <rdfs:label xml:lang="en">collection of documents</rdfs:label>
    <dcterms:description xml:lang="en">A collection of documents is a non-zero set of documents.</dcterms:description>
    <ns1:equivalentTo>http://purl.org/ontology/bibo/Collection</ns1:equivalentTo>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001413">
    <rdfs:label xml:lang="en">percentage</rdfs:label>
    <dcterms:description xml:lang="en">A percentage is a number that is a ratio expressed as a fraction of 100. It is denoted using the percent sign "%".</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001018"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001438">
    <rdfs:comment xml:lang="en">A protein-protein association is an association between two proteins.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000897"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">protein-protein association</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000368">
    <dcterms:description xml:lang="en">An equation is a mathematical statement that asserts the equality of two expressions.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">equation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001365">
    <rdfs:label xml:lang="en">rate of change</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
    <dcterms:description xml:lang="en">The amount of change accumulated per unit time.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000127">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000094"/>
    <dcterms:description xml:lang="en">A workflow is an algorithm that is is a depiction of a sequence of operations to achieve one or more objectives.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">workflow</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000042">
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000038"/>
    <rdfs:label xml:lang="en">width</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">width is the shorter dimensional extent perpendicular to a 2D projection of the object.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000048">
    <dcterms:description xml:lang="en">A quantity that extends in three dimensions.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000037"/>
    <rdfs:label xml:lang="en">3D extent quantity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000430">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">day</rdfs:label>
    <dcterms:description xml:lang="en">A day is a period of 24 hours.</dcterms:description>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000417"/>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001021">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000638"/>
    <rdfs:label xml:lang="en">expected value</rdfs:label>
    <dcterms:description xml:lang="en">An expected value (or e-value) is the weighted average of all possible values that a random variable can take on.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_001019">
