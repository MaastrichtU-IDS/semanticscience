    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:description xml:lang="en">A dose is the quantity of a chemical substance administered to a biological system.</dcterms:description>
    <rdfs:label xml:lang="en">dose</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio/v1.62/sio-subset-math.owl"/>
  </rdf:Description>
